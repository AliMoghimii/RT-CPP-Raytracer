#version 460
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_GOOGLE_include_directive : enable
layout (local_size_x = 16, local_size_y = 16) in;

#include "ray.glsl"
#include "bvh.glsl"
#include "octahedral.glsl"
#include "random.glsl"
#include "material.glsl"
#include "lighting.glsl"
#include "push_constants.glsl"

layout(binding = 0, rgba8) uniform writeonly image2D resultImage;

struct GPUSphere {
    vec3 center;
    float radius;
    int materialIndex;
    float p1;
    float p2;
    float p3;
};

struct GPUPlane {
    vec3 center;
    float p1;
    vec3 normalVector;
    int materialIndex;
    float p2;
    float p3;
    float p4;
    float p5;
};

struct GPUQuad {
    vec3 corner;
    float p1;
    vec3 edge1;
    float p2;
    vec3 edge2;
    float p3;
    vec3 normalVector;
    int materialIndex;
    float p4;
    float p5;
    float p6;
    float p7;
};

struct GPUCube {
    vec3 boundsMin;
    float p1;
    vec3 boundsMax;
    float p2;
    vec3 center;
    float p3;
    vec3 rotation;
    int materialIndex;
    float p4;
    float p5;
    float p6;
    float p7;
};

layout(std430, binding = 2) readonly buffer SphereBuffer { GPUSphere spheres[]; };
layout(std430, binding = 5) readonly buffer PlaneBuffer { GPUPlane planes[]; };
layout(std430, binding = 6) readonly buffer QuadBuffer { GPUQuad quads[]; };
layout(std430, binding = 7) readonly buffer CubeBuffer { GPUCube cubes[]; };

mat3 rotationMatrixXYZ(vec3 rot) {
    vec3 rad = radians(rot);
    vec3 c = cos(rad);
    vec3 s = sin(rad);

    mat3 rx = mat3(
        1.0, 0.0, 0.0,
        0.0, c.x, s.x,
        0.0, -s.x, c.x
    );
    mat3 ry = mat3(
        c.y, 0.0, -s.y,
        0.0, 1.0, 0.0,
        s.y, 0.0, c.y
    );
    mat3 rz = mat3(
        c.z, s.z, 0.0,
        -s.z, c.z, 0.0,
        0.0, 0.0, 1.0
    );
    return rz * ry * rx;
}

float planeIntersect(Ray ray, GPUPlane plane) {
    float denom = dot(ray.direction, plane.normalVector);
    if (abs(denom) > 1e-6) {
        float t = dot(plane.center - ray.origin, plane.normalVector) / denom;
        if (t >= 0.0001) return t;
    }
    return -1.0;
}

float quadIntersect(Ray ray, GPUQuad quad) {
    float denom = dot(ray.direction, quad.normalVector);
    if (abs(denom) > 1e-6) {
        float t = dot(quad.corner - ray.origin, quad.normalVector) / denom;
        if (t >= 0.0001) {
            vec3 hitPoint = ray.origin + ray.direction * t;
            vec3 p = hitPoint - quad.corner;
            float u = dot(p, quad.edge1) / dot(quad.edge1, quad.edge1);
            float v = dot(p, quad.edge2) / dot(quad.edge2, quad.edge2);
            if (u >= 0.0 && u <= 1.0 && v >= 0.0 && v <= 1.0) return t;
        }
    }
    return -1.0;
}

float cubeIntersect(Ray ray, GPUCube cube) {
    vec3 boxCenter = (cube.boundsMin + cube.boundsMax) * 0.5;
    vec3 worldCenter = cube.center + boxCenter;
    vec3 halfExtents = (cube.boundsMax - cube.boundsMin) * 0.5;
    
    vec3 localMin = -halfExtents;
    vec3 localMax = halfExtents;

    vec3 localOrigin = ray.origin - worldCenter;
    vec3 localDir = ray.direction;
    
    mat3 invRot = transpose(rotationMatrixXYZ(cube.rotation));
    localOrigin = invRot * localOrigin;
    localDir = invRot * localDir;
    float invDx = 1.0 / (localDir.x != 0.0 ? localDir.x : 1e-8);
    float tmin = (localMin.x - localOrigin.x) * invDx;
    float tmax = (localMax.x - localOrigin.x) * invDx;
    
    if (tmin > tmax) { float tmp = tmin; tmin = tmax; tmax = tmp; }

    float invDy = 1.0 / (localDir.y != 0.0 ? localDir.y : 1e-8);
    float tymin = (localMin.y - localOrigin.y) * invDy;
    float tymax = (localMax.y - localOrigin.y) * invDy;
    if (tymin > tymax) { float tmp = tymin; tymin = tymax; tymax = tmp; }

    if ((tmin > tymax) || (tymin > tmax)) return -1.0;
    if (tymin > tmin) tmin = tymin;
    if (tymax < tmax) tmax = tymax;

    float invDz = 1.0 / (localDir.z != 0.0 ? localDir.z : 1e-8);
    float tzmin = (localMin.z - localOrigin.z) * invDz;
    float tzmax = (localMax.z - localOrigin.z) * invDz;
    if (tzmin > tzmax) { float tmp = tzmin; tzmin = tzmax; tzmax = tmp; }

    if ((tmin > tzmax) || (tzmin > tmax)) return -1.0;
    if (tzmin > tmin) tmin = tzmin;
    if (tzmax < tmax) tmax = tzmax;

    if (tmin >= 0.0001) return tmin;
    if (tmax >= 0.0001) return tmax;
    return -1.0;
}

vec3 cubeNormal(vec3 surfacePoint, GPUCube cube) {
    vec3 boxCenter = (cube.boundsMin + cube.boundsMax) * 0.5;
    vec3 worldCenter = cube.center + boxCenter;
    vec3 halfExtents = (cube.boundsMax - cube.boundsMin) * 0.5;
    
    vec3 localMin = -halfExtents;
    vec3 localMax = halfExtents;

    vec3 localPoint = surfacePoint - worldCenter;
    mat3 invRot = transpose(rotationMatrixXYZ(cube.rotation));
    localPoint = invRot * localPoint;
    vec3 localNormal;
    float eps = 0.0001;
    
    if (abs(localPoint.x - localMin.x) < eps) localNormal = vec3(-1, 0, 0);
    else if (abs(localPoint.x - localMax.x) < eps) localNormal = vec3(1, 0, 0);
    else if (abs(localPoint.y - localMin.y) < eps) localNormal = vec3(0, -1, 0);
    else if (abs(localPoint.y - localMax.y) < eps) localNormal = vec3(0, 1, 0);
    else if (abs(localPoint.z - localMin.z) < eps) localNormal = vec3(0, 0, -1);
    else if (abs(localPoint.z - localMax.z) < eps) localNormal = vec3(0, 0, 1);
    else localNormal = vec3(0, 1, 0);

    mat3 rot = rotationMatrixXYZ(cube.rotation);
    return normalize(rot * localNormal);
}

const float MIN_DISPLACEMENT = 0.0001;

void main() {
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(resultImage);
    if (pixelCoords.x >= imageSize.x || pixelCoords.y >= imageSize.y) return;


    randState = pixelCoords.y * imageSize.x + pixelCoords.x + 1;

    float fov = 60.0;
    float halfFovTan = tan(radians(fov * 0.5));
    
    vec3 accumulatedColor = vec3(0.0);

    for (int s = 0; s < cam.primaryRaysPerPixel; s++) {
        vec2 subPixel = vec2(pixelCoords);
        if (cam.primaryRaysPerPixel > 1) {
            subPixel += vec2(rand(), rand());
        }

        vec2 uv = subPixel / vec2(imageSize) * 2.0 - 1.0;
        uv.y = -uv.y;
        uv.x *= float(imageSize.x) / float(imageSize.y);
        uv *= halfFovTan;

        vec3 rawDir = normalize(cam.camRight.xyz * uv.x + cam.camUp.xyz * uv.y + cam.camForward.xyz);
        vec3 focalPoint = cam.camPos.xyz + rawDir * cam.focalDistance;
        
        vec2 disk = randomPointOnDisk() * cam.lensRadius;

        Ray ray;
        ray.origin = cam.camPos.xyz + cam.camRight.xyz * disk.x + cam.camUp.xyz * disk.y;
        ray.direction = normalize(focalPoint - ray.origin);
        ray.tMin = 0.0001;
        ray.tMax = 999999.0;
        vec3 primaryRayDir = ray.direction;

        vec3 sampleColor = vec3(0.0);
        vec3 attenuation = vec3(1.0);
        

        for (int depth = 0; depth < cam.maxDepth; depth++) {
            float minHitDistance = 999999.0;
            int hitObjType = -1;
            int hitObjIndex = -1;
            
            float hitU = 0.0;
            float hitV = 0.0;
            for (int i = 0; i < cam.sphereCount; i++) {
                float dist = sphereIntersect(ray, spheres[i].center, spheres[i].radius);
                if (dist > 0.0 && dist < minHitDistance) { minHitDistance = dist; hitObjType = 0; hitObjIndex = i;
                }
            }
            
            for (int i = 0; i < cam.planeCount; i++) {
                float dist = planeIntersect(ray, planes[i]);
                if (dist > 0.0 && dist < minHitDistance) { minHitDistance = dist; hitObjType = 2; hitObjIndex = i;
                }
            }
            
            for (int i = 0; i < cam.quadCount; i++) {
                float dist = quadIntersect(ray, quads[i]);
                if (dist > 0.0 && dist < minHitDistance) { minHitDistance = dist; hitObjType = 3; hitObjIndex = i;
                }
            }
            
            for (int i = 0; i < cam.cubeCount; i++) {
                float dist = cubeIntersect(ray, cubes[i]);
                if (dist > 0.0 && dist < minHitDistance) { minHitDistance = dist; hitObjType = 4; hitObjIndex = i;
                }
            }

            if (cam.bvhCount > 0) {
                vec3 invDir = 1.0 / ray.direction;
                int stack[BVH_STACK_SIZE];
                int stackPtr = 0;
                stack[stackPtr++] = 0;
                
                while(stackPtr > 0) {
                    int nodeIdx = stack[--stackPtr];
                    GPUBVHNode node = bvhNodes[nodeIdx];
                    
                    float distAABB = intersectAABB(ray, invDir, node.aabbMin, node.aabbMax);
                    if (distAABB < minHitDistance) {
                        if (node.triCount > 0) {
                            for (int i = 0; i < node.triCount; i++) {
                               
                                
                                int triIdx = node.leftFirst + i;
                                float tempU, tempV;
                                float dist = triangleIntersect(ray, triangles[triIdx].v0, triangles[triIdx].v1, triangles[triIdx].v2, tempU, tempV);
                                if (dist > 0.0 && dist < minHitDistance) {
                                    minHitDistance = dist;
                                    hitObjType = 1; hitObjIndex = triIdx; hitU = tempU; hitV = tempV;
                                }
                            }
                        } else {
                            stack[stackPtr++] = node.leftFirst;
                            stack[stackPtr++] = node.leftFirst + 1;
                        }
                    }
                }
            }

            if (hitObjType == -1) {
                vec3 missCol;
                if (cam.enableSkybox == 1) {
                    float t = 0.5 * (ray.direction.y + 1.0);
                    missCol = mix(cam.skyBottomColor, cam.skyTopColor, t);
                } else if (cam.enableFog == 1) {
                    missCol = cam.fogColor;
                } else {
                    missCol = vec3(0.05, 0.05, 0.05);
                }
                
                if (cam.enableFog == 1) {
                    vec3 fogGrad = (cam.enableSkybox == 1) ? mix(cam.skyBottomColor, cam.skyTopColor, 0.5 * (ray.direction.y + 1.0)) : cam.fogColor;
                    missCol = fogGrad;
                }
                
                sampleColor += attenuation * missCol;
                break; 
            }

            if (cam.enableFog == 1) {
                float fogDensity = 0.04;
                float transmittance = exp(-minHitDistance * fogDensity);
                vec3 fogGrad = (cam.enableSkybox == 1) ? mix(cam.skyBottomColor, cam.skyTopColor, 0.5 * (primaryRayDir.y + 1.0)) : cam.fogColor;
                
                sampleColor += attenuation * fogGrad * (1.0 - transmittance);
                attenuation *= transmittance;
            }

            vec3 hitPos = ray.origin + ray.direction * minHitDistance;
            vec3 hitNormal;
            vec2 hitUV = vec2(0.0);
            GPUMaterial mat;

            if (hitObjType == 0) {
                hitNormal = normalize(hitPos - spheres[hitObjIndex].center);
                mat = materials[spheres[hitObjIndex].materialIndex];
                hitUV = vec2(0.5 + atan(hitNormal.z, hitNormal.x) / (2.0 * PI), 0.5 - asin(hitNormal.y) / PI);
            }
            else if (hitObjType == 1) {
                GPUTriangle tri = triangles[hitObjIndex];
                if (tri.isSmooth == 1) {
                    float hitW = 1.0 - hitU - hitV;
                    hitNormal = normalize(tri.n0 * hitW + tri.n1 * hitU + tri.n2 * hitV);
                } else {
                    hitNormal = tri.n0;
                }
                if (dot(ray.direction, hitNormal) > 0.0) hitNormal = -hitNormal;
                mat = materials[tri.materialIndex];
                hitUV = vec2(hitU, hitV);
            }
            else if (hitObjType == 2) {
                hitNormal = planes[hitObjIndex].normalVector;
                mat = materials[planes[hitObjIndex].materialIndex];
                hitUV = hitPos.xz * 0.1;
            }
            else if (hitObjType == 3) {
                hitNormal = quads[hitObjIndex].normalVector;
                mat = materials[quads[hitObjIndex].materialIndex];
                vec3 p = hitPos - quads[hitObjIndex].corner;
                hitUV = vec2(dot(p, quads[hitObjIndex].edge1) / dot(quads[hitObjIndex].edge1, quads[hitObjIndex].edge1), 
                             dot(p, quads[hitObjIndex].edge2) / dot(quads[hitObjIndex].edge2, quads[hitObjIndex].edge2));
            }
            else if (hitObjType == 4) {
                hitNormal = cubeNormal(hitPos, cubes[hitObjIndex]);
                mat = materials[cubes[hitObjIndex].materialIndex];
                hitUV = hitPos.xy;
            }

            vec3 baseColor = mat.color;
            if (cam.enableTextures == 1 && mat.useTexture == 1) {
                if (mat.patternType == 0) { 
                    if (mat.heightMapIndex >= 0) {
                        vec3 viewDir = normalize(getTBN(hitNormal) * -ray.direction);
    
                        float minLayers = 8.0;
                        float maxLayers = 32.0;
                        float numLayers = mix(maxLayers, minLayers, abs(dot(vec3(0.0, 0.0, 1.0), viewDir)));  
    
                        float layerDepth = 1.0 / numLayers;
                        float currentLayerDepth = 0.0;
    
                        vec2 P = viewDir.xy * mat.parallaxScale; 
                        vec2 deltaTexCoords = P / numLayers;
    
                        vec2 currentTexCoords = hitUV;
                        float currentDepthMapValue = 1.0 - textureLod(textures[nonuniformEXT(mat.heightMapIndex)], currentTexCoords, 0.0).r;
    
                        while(currentLayerDepth < currentDepthMapValue) {
                            currentTexCoords -= deltaTexCoords;
                            currentDepthMapValue = 1.0 - textureLod(textures[nonuniformEXT(mat.heightMapIndex)], currentTexCoords, 0.0).r;  
                            currentLayerDepth += layerDepth;  
                        }
    
                        vec2 prevTexCoords = currentTexCoords + deltaTexCoords;
                        float afterDepth  = currentDepthMapValue - currentLayerDepth;
                        float beforeDepth = (1.0 - textureLod(textures[nonuniformEXT(mat.heightMapIndex)], prevTexCoords, 0.0).r) - currentLayerDepth + layerDepth;
                        float weight = afterDepth / (afterDepth - beforeDepth);
    
                        hitUV = prevTexCoords * weight + currentTexCoords * (1.0 - weight);
    
                        if(hitUV.x > 1.0 || hitUV.y > 1.0 || hitUV.x < 0.0 || hitUV.y < 0.0) {
                        }
                    }
                    if (mat.albedoIndex >= 0) {
                        vec3 texCol = textureLod(textures[nonuniformEXT(mat.albedoIndex)], hitUV, 0.0).rgb;
                        baseColor = pow(max(texCol, vec3(0.0)), vec3(2.2));
                    }
                    if (mat.normalMapIndex >= 0) {
                        vec3 mapN = textureLod(textures[nonuniformEXT(mat.normalMapIndex)], hitUV, 0.0).rgb * 2.0 - 1.0;
                        
                        // mapN.y = -mapN.y; (For NormalGL maps)
                        
                        hitNormal = normalize(getTBN(hitNormal) * mapN);
                    }
                    if (mat.roughnessIndex >= 0) {
                        mat.roughness = textureLod(textures[nonuniformEXT(mat.roughnessIndex)], hitUV, 0.0).r;
                    }
                    if (mat.aoIndex >= 0) {
                        mat.ambient *= textureLod(textures[nonuniformEXT(mat.aoIndex)], hitUV, 0.0).r;
                    }
                }
                else if (mat.patternType == 1) { 
                    float scale = mat.proceduralScale > 0.0 ? mat.proceduralScale : 3.0;
                    float pattern = mod(floor((hitPos.x + 5.0) * scale) + floor(hitPos.z * scale), 2.0);
                    baseColor = (pattern > 0.5) ? mat.color2 : mat.color;
                }
                else if (mat.patternType == 2) { 
                    float spacing = mat.proceduralScale > 0.0 ? mat.proceduralScale : 16.0;
                    float wobble = mat.proceduralWobble > 0.0 ? mat.proceduralWobble : 3.0;
                    float turbulence = fbm(hitPos * 2.0);
                    float wood = fract(length(hitPos.xz) * spacing + turbulence * wobble);
                    baseColor = mix(mat.color2, mat.color, wood);
                }
                else if (mat.patternType == 3) { 
                    float scale = mat.proceduralScale > 0.0 ? mat.proceduralScale : 2.0;
                    float turbulence = fbm(hitPos * scale);
                    float marble = sin(hitPos.x * 5.0 + turbulence * 10.0) * 0.5 + 0.5;
                    baseColor = mix(mat.color, mat.color2, marble);
                }
            }

            vec3 rayToCameraDir = normalize(cam.camPos.xyz - hitPos);
            vec3 glow = mat.emission;
            vec3 localColor = (baseColor * mat.ambient) + glow;

            for (int l = 0; l < cam.lightCount; l++) {
                vec3 baseLightDir = normalize(lights[l].position - hitPos);
                float lightDistance = length(lights[l].position - hitPos);
                vec3 totalVisibility = vec3(0.0);

                if (lights[l].radius <= 0.0001) {
                    Ray shadowRay;
                    shadowRay.origin = hitPos + hitNormal * MIN_DISPLACEMENT;
                    shadowRay.direction = baseLightDir;
                    shadowRay.tMin = 0.0001;
                    shadowRay.tMax = 999999.0;
                    vec3 shadowColor = vec3(1.0);
                    
                    for (int i = 0; i < cam.sphereCount; i++) {
                        float dist = sphereIntersect(shadowRay, spheres[i].center, spheres[i].radius);
                        if (dist > 0.0 && dist < lightDistance) { 
                            GPUMaterial smat = materials[spheres[i].materialIndex];
                            if (smat.castShadows == 1) {
                                if (smat.transparency > 0.0) {
                                    shadowColor *= smat.color * smat.transparency;
                                } else {
                                    shadowColor = vec3(0.0);
                                    break;
                                }
                            }
                        }
                    }
                    
                    if (shadowColor.x > 0.0 || shadowColor.y > 0.0 || shadowColor.z > 0.0) {
                        for (int i = 0; i < cam.planeCount; i++) 
                        {
                           float dist = planeIntersect(shadowRay, planes[i]);
                            if (dist > 0.0 && dist < lightDistance) { 
                                GPUMaterial smat = materials[planes[i].materialIndex];
                                if (smat.castShadows == 1) {
                                    if (smat.transparency > 0.0) { shadowColor *= smat.color * smat.transparency; } 
                                    else { shadowColor = vec3(0.0); break; }
                                }
                            }
                        }
                    }
                    
                    if (shadowColor.x > 0.0 || shadowColor.y > 0.0 || shadowColor.z > 0.0) {
                       for (int i = 0; i < cam.quadCount; i++) 
                        {
                           float dist = quadIntersect(shadowRay, quads[i]);
                           if (dist > 0.0 && dist < lightDistance) { 
                               GPUMaterial smat = materials[quads[i].materialIndex];
                               if (smat.castShadows == 1) {
                                   if (smat.transparency > 0.0) { shadowColor *= smat.color * smat.transparency; }
                                   else { shadowColor = vec3(0.0); break; }
                               }
                           }
                        }
                    }
                    
                    if (shadowColor.x > 0.0 || shadowColor.y > 0.0 || shadowColor.z > 0.0) {
                          for (int i = 0; i < cam.cubeCount; i++) {
                           float dist = cubeIntersect(shadowRay, cubes[i]);
                           if (dist > 0.0 && dist < lightDistance) { 
                               GPUMaterial smat = materials[cubes[i].materialIndex];
                               if (smat.castShadows == 1) {
                                   if (smat.transparency > 0.0) { shadowColor *= smat.color * smat.transparency; }
                                   else { shadowColor = vec3(0.0); break; }
                               }
                           }
                        }
                    }
                    
                    if ((shadowColor.x > 0.0 || shadowColor.y > 0.0 || shadowColor.z > 0.0) && cam.bvhCount > 0) {
                        vec3 shadowInvDir = 1.0 / shadowRay.direction;
                        int stackS[BVH_STACK_SIZE];
                        int stackPtrS = 0;
                        stackS[stackPtrS++] = 0;
                        
                        while(stackPtrS > 0) {
                            int nodeIdx = stackS[--stackPtrS];
                            GPUBVHNode node = bvhNodes[nodeIdx];
                            if (intersectAABB(shadowRay, shadowInvDir, node.aabbMin, node.aabbMax) < lightDistance) {
                                if (node.triCount > 0) {
                                    for (int i = 0; i < node.triCount; i++) {
                                        float dU, dV;
                                        float dist = triangleIntersect(shadowRay, triangles[node.leftFirst + i].v0, triangles[node.leftFirst + i].v1, triangles[node.leftFirst + i].v2, dU, dV);
                                        if (dist > 0.0 && dist < lightDistance) { 
                                            GPUMaterial smat = materials[triangles[node.leftFirst + i].materialIndex];
                                            if (smat.castShadows == 1) {
                                                if (smat.transparency > 0.0) { shadowColor *= smat.color * smat.transparency; }
                                                else { shadowColor = vec3(0.0); break; }
                                            }
                                        }
                                    }
                                    if (shadowColor == vec3(0.0)) {
                                        stackPtrS = 0; 
                                        break;
                                    }
                                } else {
                                    stackS[stackPtrS++] = node.leftFirst;
                                    stackS[stackPtrS++] = node.leftFirst + 1;
                                }
                            }
                        }
                    }
                    totalVisibility = shadowColor;
                }

                else {
                    for (int sr = 0; sr < cam.shadowRays; sr++) {
                        float u = (rand() * 2.0 - 1.0) * 0.8;
                        float v = (rand() * 2.0 - 1.0) * 0.8;
                        float w = (rand() * 2.0 - 1.0) * 0.8;
                        vec3 jitter = vec3(u, v, w) * lights[l].radius;
                        
                        vec3 targetLightPos = lights[l].position + jitter;
                        vec3 lightDir = normalize(targetLightPos - hitPos);
                        float jitteredLightDistance = length(targetLightPos - hitPos);
                        
                        Ray shadowRay;
                        shadowRay.origin = hitPos + hitNormal * MIN_DISPLACEMENT;
                        shadowRay.direction = lightDir;
                        shadowRay.tMin = 0.0001;
                        shadowRay.tMax = 999999.0;
                        vec3 shadowColor = vec3(1.0);
                        
                        for (int i = 0; i < cam.sphereCount; i++) {
                            float dist = sphereIntersect(shadowRay, spheres[i].center, spheres[i].radius);
                            if (dist > 0.0 && dist < jitteredLightDistance) { 
                                GPUMaterial smat = materials[spheres[i].materialIndex];
                                if (smat.castShadows == 1) {
                                    if (smat.transparency > 0.0) { shadowColor *= smat.color * smat.transparency; }
                                    else { shadowColor = vec3(0.0); break; }
                                }
                            }
                        }
                        if (shadowColor.x > 0.0 || shadowColor.y > 0.0 || shadowColor.z > 0.0) {
                           for (int i = 0; i < cam.planeCount; i++) {
                              float dist = planeIntersect(shadowRay, planes[i]);
                                if (dist > 0.0 && dist < jitteredLightDistance) { 
                                    GPUMaterial smat = materials[planes[i].materialIndex];
                                    if (smat.castShadows == 1) {
                                        if (smat.transparency > 0.0) { shadowColor *= smat.color * smat.transparency; }
                                        else { shadowColor = vec3(0.0); break; }
                                    }
                                }
                            }
                        }
               
                         if (shadowColor.x > 0.0 || shadowColor.y > 0.0 || shadowColor.z > 0.0) {
                            for (int i = 0; i < cam.quadCount; i++) 
                            {
                                float dist = quadIntersect(shadowRay, quads[i]);
                                if (dist > 0.0 && dist < jitteredLightDistance) { 
                                    GPUMaterial smat = materials[quads[i].materialIndex];
                                    if (smat.castShadows == 1) {
                                        if (smat.transparency > 0.0) { shadowColor *= smat.color * smat.transparency; }
                                        else { shadowColor = vec3(0.0); break; }
                                    }
                                }
                            }
                        }
               
                         if (shadowColor.x > 0.0 || shadowColor.y > 0.0 || shadowColor.z > 0.0) {
                            for (int i = 0; i < cam.cubeCount; i++) {
                                float dist = cubeIntersect(shadowRay, cubes[i]);
                                if (dist > 0.0 && dist < jitteredLightDistance) { 
                                    GPUMaterial smat = materials[cubes[i].materialIndex];
                                    if (smat.castShadows == 1) {
                                        if (smat.transparency > 0.0) { shadowColor *= smat.color * smat.transparency; }
                                        else { shadowColor = vec3(0.0); break; }
                                    }
                                }
                            }
                        }
               
                        if ((shadowColor.x > 0.0 || shadowColor.y > 0.0 || shadowColor.z > 0.0) && cam.bvhCount > 0) {
                             vec3 shadowInvDir = 1.0 / shadowRay.direction;
                            int stackS[BVH_STACK_SIZE];
                            int stackPtrS = 0;
                            stackS[stackPtrS++] = 0;
                            
                            while(stackPtrS > 0) {
                                int nodeIdx = stackS[--stackPtrS];
                                GPUBVHNode node = bvhNodes[nodeIdx];
                                if (intersectAABB(shadowRay, shadowInvDir, node.aabbMin, node.aabbMax) < jitteredLightDistance) {
                                    if (node.triCount > 0) {
                                        for (int i = 0; i < node.triCount; i++) 
                                        {
                                            float dU, dV;
                                            float dist = triangleIntersect(shadowRay, triangles[node.leftFirst + i].v0, triangles[node.leftFirst + i].v1, triangles[node.leftFirst + i].v2, dU, dV);
                                            if (dist > 0.0 && dist < jitteredLightDistance) { 
                                                GPUMaterial smat = materials[triangles[node.leftFirst + i].materialIndex];
                                                if (smat.castShadows == 1) {
                                                    if (smat.transparency > 0.0) { shadowColor *= smat.color * smat.transparency; }
                                                    else { shadowColor = vec3(0.0); break; }
                                                }
                                            }
                                        }
                                         if (shadowColor == vec3(0.0)) {
                                            stackPtrS = 0;
                                            break;
                                         }
                                    } else {
                                        stackS[stackPtrS++] = node.leftFirst;
                                        stackS[stackPtrS++] = node.leftFirst + 1;
                                    }
                                }
                            }
                        }
                     totalVisibility += shadowColor;
                    }
                    totalVisibility /= float(cam.shadowRays);
                }

                if (totalVisibility.x > 0.0 || totalVisibility.y > 0.0 || totalVisibility.z > 0.0) {
                    float attenuationFactor = 1.0 / max(lightDistance * lightDistance, 0.01);
                    vec3 attenuatedLightColor = lights[l].color * attenuationFactor * totalVisibility;

                    if (mat.shadingModel == 1) {
                        localColor += pbrShading(mat, baseColor, hitNormal, rayToCameraDir, baseLightDir, attenuatedLightColor);
                    } else {
                        localColor += lambertianShading(mat, baseColor, hitNormal, baseLightDir, attenuatedLightColor);
                        localColor += blingPhongShading(mat, attenuatedLightColor, hitNormal, baseLightDir, rayToCameraDir, 50.0);
                    }
                }
            }

            if (mat.transparency > 0.0) {
                float cosI = dot(ray.direction, hitNormal);
                float eta;
                vec3 n = hitNormal;
                
                if (cosI < 0.0) {
                    eta = 1.0 / mat.ior;
                    cosI = -cosI;
                } else {
                    eta = mat.ior;
                    n = -hitNormal;
                }
                
                float r0 = (1.0 - eta) / (1.0 + eta);
                r0 = r0 * r0;
                float fresnel = r0 + (1.0 - r0) * pow(1.0 - cosI, 5.0);
                vec3 refractDir = refract(ray.direction, n, eta);
                
                if (length(refractDir) < 0.001) fresnel = 1.0;
                if (fresnel < 1.0 && length(refractDir) > 0.001) {
                    sampleColor += attenuation * localColor * (1.0 - mat.transparency);
                    attenuation *= mat.transparency * (1.0 - fresnel) * baseColor; 
                    ray.origin = hitPos - n * MIN_DISPLACEMENT; 
                    ray.direction = normalize(refractDir);
                } else {
                    sampleColor += attenuation * localColor * (1.0 - mat.reflection);
                    attenuation *= mat.reflection;
                    ray.origin = hitPos + n * MIN_DISPLACEMENT;
                    ray.direction = reflect(ray.direction, n);
                }
            } 
            else if (mat.reflection > 0.0) {
                sampleColor += attenuation * localColor * (1.0 - mat.reflection);
                attenuation *= mat.reflection;
                ray.origin = hitPos + hitNormal * MIN_DISPLACEMENT;
                ray.direction = reflect(ray.direction, hitNormal);
            } 
            else {
                sampleColor += attenuation * localColor;
                break; 
            }
        }
        
        accumulatedColor += sampleColor;
    }

    vec3 finalColor = accumulatedColor / float(cam.primaryRaysPerPixel);

    // Apply Reinhard tonemap
    vec3 tonemapped = finalColor / (1.0 + finalColor);

    // Apply gamma correction (linear -> sRGB)
    tonemapped = pow(tonemapped, vec3(1.0 / 2.2));

    imageStore(resultImage, pixelCoords, vec4(tonemapped, 1.0));
}