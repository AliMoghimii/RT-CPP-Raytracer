#version 460
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_GOOGLE_include_directive : enable
layout (local_size_x = 256) in;

#include "../common/ray.glsl"
#include "../common/bvh.glsl"
#include "../common/random.glsl"
#include "../common/material.glsl"
#include "../common/lighting.glsl"
#include "../common/push_constants.glsl"

// --- Analytical Geometry Structs ---
struct GPUSphere { vec3 center; float radius; int materialIndex; float p1; float p2; float p3; };
struct GPUPlane { vec3 center; float p1; vec3 normalVector; int materialIndex; float p2; float p3; float p4; float p5; };
struct GPUQuad { vec3 corner; float p1; vec3 edge1; float p2; vec3 edge2; float p3; vec3 normalVector; int materialIndex; float p4; float p5; float p6; float p7; };
struct GPUCube { vec3 boundsMin; float p1; vec3 boundsMax; float p2; vec3 center; float p3; vec3 rotation; int materialIndex; float p4; float p5; float p6; float p7; };

// --- Geometry Bindings ---
layout(std430, set = 0, binding = 2) readonly buffer SphereBuffer { GPUSphere spheres[]; };
layout(std430, set = 0, binding = 5) readonly buffer PlaneBuffer { GPUPlane planes[]; };
layout(std430, set = 0, binding = 6) readonly buffer QuadBuffer { GPUQuad quads[]; };
layout(std430, set = 0, binding = 7) readonly buffer CubeBuffer { GPUCube cubes[]; };

// --- Write-Only Caustic Bindings ---
struct GPUPhoton { vec4 position; vec4 direction; vec4 energy; };
layout(std430, set = 0, binding = 10) writeonly buffer PhotonBuffer { GPUPhoton photons[]; };
layout(std430, set = 0, binding = 11) buffer PhotonCounter { uint globalPhotonCount; };
layout(std430, set = 0, binding = 12) buffer GridHeadBuffer { int gridHeads[]; };
layout(std430, set = 0, binding = 13) writeonly buffer PhotonNextBuffer { int photonNexts[]; };

ivec3 getGridCoords(vec3 pos) {
    vec3 norm = (pos - cam.gridMin.xyz) / (cam.gridMax.xyz - cam.gridMin.xyz);
    return ivec3(clamp(norm * vec3(cam.gridRes), vec3(0.0), vec3(cam.gridRes - 1)));
}

int getGridIndex(ivec3 coords) {
    return coords.x + coords.y * cam.gridRes + coords.z * cam.gridRes * cam.gridRes;
}

// Intersections
float sphereIntersect(Ray ray, GPUSphere sphere) {
    vec3 oc = ray.origin - sphere.center;
    float a = 1.0; float b = 2.0 * dot(ray.direction, oc); float c = dot(oc, oc) - (sphere.radius * sphere.radius);
    float discriminant = b * b - 4.0 * a * c;
    if (discriminant >= 0.0) {
        float dist = (-b - sqrt(discriminant)) / (2.0 * a); if (dist > 0.0001) return dist;
        dist = (-b + sqrt(discriminant)) / (2.0 * a);       if (dist > 0.0001) return dist;
    } return -1.0;
}

float planeIntersect(Ray ray, GPUPlane plane) {
    float denom = dot(ray.direction, plane.normalVector);
    if (abs(denom) > 1e-6) { float t = dot(plane.center - ray.origin, plane.normalVector) / denom; if (t >= 0.0001) return t; } return -1.0;
}

float quadIntersect(Ray ray, GPUQuad quad) {
    float denom = dot(ray.direction, quad.normalVector);
    if (abs(denom) > 1e-6) {
        float t = dot(quad.corner - ray.origin, quad.normalVector) / denom;
        if (t >= 0.0001) {
            vec3 p = (ray.origin + ray.direction * t) - quad.corner;
            float u = dot(p, quad.edge1) / dot(quad.edge1, quad.edge1);
            float v = dot(p, quad.edge2) / dot(quad.edge2, quad.edge2);
            if (u >= 0.0 && u <= 1.0 && v >= 0.0 && v <= 1.0) return t;
        }
    } return -1.0;
}

mat3 rotationMatrixXYZ(vec3 rot) {
    vec3 rad = radians(rot); vec3 c = cos(rad); vec3 s = sin(rad);
    mat3 rx = mat3(1.0, 0.0, 0.0, 0.0, c.x, s.x, 0.0, -s.x, c.x);
    mat3 ry = mat3(c.y, 0.0, -s.y, 0.0, 1.0, 0.0, s.y, 0.0, c.y);
    mat3 rz = mat3(c.z, s.z, 0.0, -s.z, c.z, 0.0, 0.0, 0.0, 1.0);
    return rz * ry * rx;
}

float cubeIntersect(Ray ray, GPUCube cube) {
    vec3 boxCenter = (cube.boundsMin + cube.boundsMax) * 0.5; vec3 worldCenter = cube.center + boxCenter; vec3 halfExtents = (cube.boundsMax - cube.boundsMin) * 0.5;
    vec3 localOrigin = ray.origin - worldCenter; vec3 localDir = ray.direction;
    mat3 invRot = transpose(rotationMatrixXYZ(cube.rotation));
    localOrigin = invRot * localOrigin; localDir = invRot * localDir;
    
    vec3 t0 = (-halfExtents - localOrigin) / localDir; vec3 t1 = (halfExtents - localOrigin) / localDir;
    vec3 tmin = min(t0, t1); vec3 tmax = max(t0, t1);
    float maxTmin = max(max(tmin.x, tmin.y), tmin.z); float minTmax = min(min(tmax.x, tmax.y), tmax.z);
    
    if (maxTmin <= minTmax && minTmax > 0.0) return maxTmin < 0.0 ? 0.0 : maxTmin;
    return -1.0;
}

vec3 cubeNormal(vec3 surfacePoint, GPUCube cube) {
    vec3 boxCenter = (cube.boundsMin + cube.boundsMax) * 0.5; vec3 worldCenter = cube.center + boxCenter; vec3 halfExtents = (cube.boundsMax - cube.boundsMin) * 0.5;
    vec3 localPoint = transpose(rotationMatrixXYZ(cube.rotation)) * (surfacePoint - worldCenter);
    vec3 localNormal; float eps = 0.0001;
    if (abs(localPoint.x - (-halfExtents.x)) < eps) localNormal = vec3(-1, 0, 0); else if (abs(localPoint.x - halfExtents.x) < eps) localNormal = vec3(1, 0, 0);
    else if (abs(localPoint.y - (-halfExtents.y)) < eps) localNormal = vec3(0, -1, 0); else if (abs(localPoint.y - halfExtents.y) < eps) localNormal = vec3(0, 1, 0);
    else if (abs(localPoint.z - (-halfExtents.z)) < eps) localNormal = vec3(0, 0, -1); else if (abs(localPoint.z - halfExtents.z) < eps) localNormal = vec3(0, 0, 1);
    return normalize(rotationMatrixXYZ(cube.rotation) * localNormal);
}

void main() {
    uint photonID = gl_GlobalInvocationID.x;
    if (photonID >= cam.totalEmittedPhotons) return;

    randState = photonID * 747796405u + 2891336453u;

    GPULight light = lights[0];
    float z = rand() * 2.0 - 1.0;
    float a = rand() * 2.0 * PI;
    float r = sqrt(1.0 - z * z);
    vec3 randomDir = vec3(r * cos(a), r * sin(a), z);

    Ray photonRay;
    photonRay.origin = light.position;
    photonRay.direction = randomDir;
    
    vec3 currentEnergy = light.color / float(cam.totalEmittedPhotons); 

    bool isCaustic = false;
    for (int depth = 0; depth < cam.maxDepth; depth++) {
        float minHitDistance = 999999.0;
        int hitObjType = -1; int hitObjIndex = -1;

        for (int i = 0; i < cam.sphereCount; i++) { float dist = sphereIntersect(photonRay, spheres[i]); if (dist > 0.001 && dist < minHitDistance) { minHitDistance = dist; hitObjType = 0; hitObjIndex = i; } }
        for (int i = 0; i < cam.planeCount; i++) { float dist = planeIntersect(photonRay, planes[i]); if (dist > 0.001 && dist < minHitDistance) { minHitDistance = dist; hitObjType = 2; hitObjIndex = i; } }
        for (int i = 0; i < cam.quadCount; i++) { float dist = quadIntersect(photonRay, quads[i]); if (dist > 0.001 && dist < minHitDistance) { minHitDistance = dist; hitObjType = 3; hitObjIndex = i; } }
        for (int i = 0; i < cam.cubeCount; i++) { float dist = cubeIntersect(photonRay, cubes[i]); if (dist > 0.001 && dist < minHitDistance) { minHitDistance = dist; hitObjType = 4; hitObjIndex = i; } }

        if (cam.bvhCount > 0) {
            vec3 invDir = 1.0 / photonRay.direction;
            int stack[64]; int stackPtr = 0; stack[stackPtr++] = 0;
            while(stackPtr > 0) {
                int nodeIdx = stack[--stackPtr];
                GPUBVHNode node = bvhNodes[nodeIdx];
                if (intersectAABB(photonRay, invDir, node.aabbMin, node.aabbMax) < minHitDistance) {
                    if (node.triCount > 0) {
                        for (int i = 0; i < node.triCount; i++) {
                            int triIdx = node.leftFirst + i; float tU, tV;
                            GPUTriangle tri = triangles[triIdx];
                            float dist = triangleIntersect(photonRay, tri.v0, tri.v1, tri.v2, tU, tV);
                            if (dist > 0.001 && dist < minHitDistance) {
                                minHitDistance = dist; hitObjType = 1; hitObjIndex = triIdx;
                            }
                        }
                    } else {
                        stack[stackPtr++] = node.leftFirst; stack[stackPtr++] = node.leftFirst + 1;
                    }
                }
            }
        }

        if (hitObjType == -1) break;
        vec3 hitPos = photonRay.origin + photonRay.direction * minHitDistance;
        GPUMaterial mat; vec3 hitNormal;

        if (hitObjType == 0) { hitNormal = normalize(hitPos - spheres[hitObjIndex].center); mat = materials[spheres[hitObjIndex].materialIndex]; }
        else if (hitObjType == 1) { hitNormal = triangles[hitObjIndex].n0; mat = materials[triangles[hitObjIndex].materialIndex]; } 
        else if (hitObjType == 2) { hitNormal = planes[hitObjIndex].normalVector; mat = materials[planes[hitObjIndex].materialIndex]; }
        else if (hitObjType == 3) { hitNormal = quads[hitObjIndex].normalVector; mat = materials[quads[hitObjIndex].materialIndex]; }
        else if (hitObjType == 4) { hitNormal = cubeNormal(hitPos, cubes[hitObjIndex]); mat = materials[cubes[hitObjIndex].materialIndex]; }

        vec3 originalNormal = hitNormal;
        if (dot(photonRay.direction, hitNormal) > 0.0) hitNormal = -hitNormal;

        if (mat.transparency > 0.0) {
            isCaustic = true;
            float cosI = dot(photonRay.direction, originalNormal);
            float eta = (cosI < 0.0) ? (1.0 / mat.ior) : mat.ior;
            vec3 n = (cosI < 0.0) ? originalNormal : -originalNormal;
            
            vec3 refractDir = refract(photonRay.direction, n, eta);
            if (length(refractDir) < 0.001) {
                photonRay.origin = hitPos + n * 0.001; photonRay.direction = reflect(photonRay.direction, n);
            } else {
                photonRay.origin = hitPos - n * 0.001; photonRay.direction = normalize(refractDir);
            }
            currentEnergy *= mat.color * mat.transparency;
        } else if (mat.reflection > 0.0) {
            isCaustic = true;
            photonRay.origin = hitPos + hitNormal * 0.001;
            photonRay.direction = reflect(photonRay.direction, hitNormal);
            currentEnergy *= mat.color * mat.reflection;
        } else {
            if (isCaustic) {
                currentEnergy *= mat.color * mat.diffuse;
                uint storeIndex = atomicAdd(globalPhotonCount, 1);
                
                if (storeIndex < 1000000) { 
                    photons[storeIndex].position = vec4(hitPos, 1.0);
                    photons[storeIndex].direction = vec4(photonRay.direction, 0.0);
                    photons[storeIndex].energy = vec4(currentEnergy, 0.0);
                    
                    ivec3 coords = getGridCoords(hitPos);
                    int gridIdx = getGridIndex(coords);
                    int prevHead = atomicExchange(gridHeads[gridIdx], int(storeIndex));
                    photonNexts[storeIndex] = prevHead;
                }
            }
            break;
        }
    }
}