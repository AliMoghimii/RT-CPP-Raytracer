#version 460
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;

// Reverse blur pass: reads blurredCascadeData (b6), writes cascadeData (b4).
// Used as the middle step in the 3-pass ping-pong:
//   pass 1 (probe_blur.comp):     cascadeData(b4) → blurredCascadeData(b6)
//   pass 2 (probe_blur_rev.comp): blurredCascadeData(b6) → cascadeData(b4)
//   pass 3 (probe_blur.comp):     cascadeData(b4) → blurredCascadeData(b6)
// cascade_layout.glsl references hashKeys/hashValues by name — declare SSBOs first.
layout(std430, set = 0, binding = 0) readonly  buffer HK  { uint hashKeys[];         };
layout(std430, set = 0, binding = 1) readonly  buffer HV  { uint hashValues[];        };
layout(std430, set = 0, binding = 2) readonly  buffer STK { uint slotToKey[];         };
layout(std430, set = 0, binding = 3) readonly  buffer SC  { uint nextSlot;            };
layout(std430, set = 0, binding = 4) writeonly buffer CD  { uvec2 cascadeData[];      };
layout(std430, set = 0, binding = 6) readonly  buffer BCD { uvec2 blurredCascadeData[]; };

#include "../common/cascade_layout.glsl"

layout(push_constant) uniform BlurPC {
    ivec4 gridSizeOctRes;   // xyz = cascade-0 grid size, w = octRes
    int   hashSize;
    int   maxActiveSlots;
    int   pad[2];
} pc;

void main() {
    uint tid = gl_GlobalInvocationID.x;

    int octRes   = pc.gridSizeOctRes.w;
    int dirCount = octRes * octRes;
    uint activeProbes = nextSlot;

    uint slot = tid / uint(dirCount);
    int  d    = int(tid % uint(dirCount));

    if (slot >= activeProbes || slot >= uint(pc.maxActiveSlots)) return;

    uint myKey  = slotToKey[slot];
    ivec3 cell  = unpackCellKey(myKey);

    int base = probeStorageBase(slot, octRes);
    vec4 accumulated = unpackRadianceTransmittance(blurredCascadeData[base + d]);
    float count = 1.0;

    const ivec3 offsets[6] = ivec3[6](
        ivec3(+1, 0, 0), ivec3(-1, 0, 0),
        ivec3( 0,+1, 0), ivec3( 0,-1, 0),
        ivec3( 0, 0,+1), ivec3( 0, 0,-1)
    );

    for (int i = 0; i < 6; i++) {
        ivec3 nCell = cell + offsets[i];
        if (any(lessThan(nCell, ivec3(0))) ||
            any(greaterThanEqual(nCell, pc.gridSizeOctRes.xyz))) continue;

        uint nKey  = packCellKey(nCell);
        uint nSlot = probeLookup(nKey, uint(pc.hashSize));
        if (nSlot == 0xFFFFFFFFu) continue;

        int nBase = probeStorageBase(nSlot, octRes);
        accumulated += unpackRadianceTransmittance(blurredCascadeData[nBase + d]);
        count += 1.0;
    }

    accumulated /= count;
    cascadeData[base + d] = packRadianceTransmittance(accumulated.rgb, accumulated.a);
}
