#version 460
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 256) in;

#include "../common/octahedral.glsl"

// cascade-0 hash map SSBOs (set 0 = rcHashDescSets[0])
// Only nextSlot and cascadeData are needed; others exist in the layout but are not used here.
layout(std430, set = 0, binding = 3) readonly buffer SC { uint nextSlot;       };
layout(std430, set = 0, binding = 4) readonly buffer CD { uvec2 cascadeData[]; };
layout(std430, set = 0, binding = 6) writeonly buffer SH { vec4  shCoeffs[];   };

layout(push_constant) uniform SHPC {
    int octRes;
    int maxActiveSlots;
} pc;

// Inline helpers (subset of cascade_layout.glsl, avoids hash-map SSBO requirements)
int probeStorageBase(uint slot, int res) { return int(slot) * res * res; }

vec3 unpackRadiance(uvec2 packed) {
    vec2 xy = unpackHalf2x16(packed.x);
    vec2 zw = unpackHalf2x16(packed.y);
    return vec3(xy.x, xy.y, zw.x);
}

// Spherical Harmonics (SH) L0+L1 projection.
//
// After cascade-0 probes are traced and merged, each probe has N = octRes^2 radiance
// samples, one per direction on the octahedral map.  Reading all N samples every time
// a shading pass wants the irradiance at a surface point would require N texture lookups.
// Instead we project the radiance function into 4 SH coefficients (one L0 + three L1)
// so that irradiance can be evaluated for any normal with a single dot product:
//
//   irradiance(n) = sh0 + sh1*n.x + sh2*n.y + sh3*n.z
//
// This is equivalent to a first-order spherical harmonic expansion of the incoming
// radiance integrated against a cosine lobe (the Lambertian BRDF kernel).
//
// Derivation of K0/K1:
//   The SH coefficients for a radiance distribution L(d) sampled at N uniform directions
//   are: c_i = SUM_d { L(d) * Y_i(d) * w(d) }
//   where Y_0 = 1/(2*sqrt(PI)), Y_1,x = sqrt(3)/(2*sqrt(PI)) * d.x (etc.),
//   and w(d) = 4*PI/N (uniform solid angle weight for N samples on the sphere).
//   The irradiance integral introduces an additional cosine-lobe factor of (1/PI).
//   Multiplying out all constants gives K0 = PI/(2N) and K1 = 3*PI/(2N).
void main() {
    uint slot = gl_GlobalInvocationID.x;
    if (slot >= nextSlot || slot >= uint(pc.maxActiveSlots)) return;

    int octRes = pc.octRes;
    int N = octRes * octRes;
    int storageBase = probeStorageBase(slot, octRes);

    // Scale factors for unnormalized projection (c0 = SUM L, cx = SUM L*d.x — no SH basis weighting).
    // Derivation: for uniform L=1, E(n) must equal PI (Lambertian hemisphere integral).
    //   c0 = N  =>  K0 * N = PI  =>  K0 = PI/N
    //   K1 = 2*PI/N  (from A1=2PI/3 Lambertian convolution × Y1 normalization × 4PI/N weight)
    //   K1/K0 = 2  (not 3 — the previous value entangled the SH basis normalization incorrectly)
    float K0 = 3.14159265 / float(N);          // L0: isotropic Lambertian irradiance
    float K1 = 2.0 * 3.14159265 / float(N);   // L1: directional gradient

    // Accumulate weighted projections: c_i += L(d) * Y_i(d)
    // For L0 the basis function is constant (1), so c0 is just the sum of radiance.
    // For L1 the basis functions are the direction components (d.x, d.y, d.z).
    vec3 c0 = vec3(0.0), cx = vec3(0.0), cy = vec3(0.0), cz = vec3(0.0);

    for (int d = 0; d < N; d++) {
        vec2 uv  = octIndexToUV(ivec2(d % octRes, d / octRes), octRes);
        vec3 dir = octDecode(uv);
        vec3 L   = unpackRadiance(cascadeData[storageBase + d]);
        c0 += L;           // L0: isotropic (ambient) term
        cx += L * dir.x;   // L1: x-axis directional term
        cy += L * dir.y;   // L1: y-axis directional term
        cz += L * dir.z;   // L1: z-axis directional term
    }

    // Write 4 coefficients per probe (offset by slot * 4).
    // Evaluation in gather passes: sh0 + sh1*n.x + sh2*n.y + sh3*n.z
    int base4 = int(slot) * 4;
    shCoeffs[base4 + 0] = vec4(c0 * K0, 0.0);
    shCoeffs[base4 + 1] = vec4(cx * K1, 0.0);
    shCoeffs[base4 + 2] = vec4(cy * K1, 0.0);
    shCoeffs[base4 + 3] = vec4(cz * K1, 0.0);
}
