#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable
// Per-ray dispatch: each thread handles one ray for one direction of one probe.
// The 1D global index is decomposed as: slot = idx / raysPerProbe, localRay = idx % raysPerProbe.
// This keeps all threads of a workgroup working on the same probe (good for cache coherency
// since they all read from the same slotToKey[] entry and cascadeData[] base offset).
layout(local_size_x = 256) in;

#include "../common/ray.glsl"
#include "../common/bvh.glsl"
#include "../common/material.glsl"
#include "../common/lighting.glsl"
#include "../common/shadow.glsl"
#include "../common/octahedral.glsl"
#include "../common/random.glsl"

// Plane and quad geometry (room walls — not in BVH)
struct GPUPlane {
    vec3 center; float p1;
    vec3 normal; int  materialIndex;
    float p2; float p3; float p4; float p5;
};
struct GPUQuad {
    vec3 corner;       float p1;
    vec3 edge1;        float p2;
    vec3 edge2;        float p3;
    vec3 normalVector; int   materialIndex;
    float p4; float p5; float p6; float p7;
};
layout(std430, set = 0, binding = 5) readonly buffer PlaneBuffer { GPUPlane planes[]; };
layout(std430, set = 0, binding = 6) readonly buffer QuadBuffer  { GPUQuad  quads[];  };

// Current cascade hash map and data at set 1
layout(std430, set = 1, binding = 0) readonly buffer HK  { uint hashKeys[]; };
layout(std430, set = 1, binding = 1) readonly buffer HV  { uint hashValues[]; };
layout(std430, set = 1, binding = 2) readonly buffer STK { uint slotToKey[]; };
layout(std430, set = 1, binding = 3) readonly buffer SC  { uint nextSlot; };
layout(std430, set = 1, binding = 4)          buffer CD  { uvec2 cascadeData[]; };

#include "../common/cascade_layout.glsl"

layout(push_constant) uniform TracePC {
    ivec4 gridSizeOctRes;       // xyz unused in trace, w = octRes
    vec4 worldOriginSpacing;    // xyz = worldOrigin, w = spacing
    float intervalStart;
    float intervalEnd;
    int bvhCount;
    int maxActiveSlots;
    int lightCount;
    int planeCount;
    int quadCount;
    int evaluateDirect;         // 1 = cascade-0 (direct+emission), 0 = levels 1+ (emission-only)
    int softShadowSamples;      // 1 = hard shadow (original path), >1 = area-light jitter for BVH shadow
} pc;

void main()
{
    int octRes = pc.gridSizeOctRes.w;
    uint raysPerProbe = uint(octRes * octRes);
    uint globalIdx = gl_GlobalInvocationID.x;
    uint slot = globalIdx / raysPerProbe;
    uint localRay = globalIdx % raysPerProbe;

    if (slot >= nextSlot || slot >= uint(pc.maxActiveSlots)) return;

    int dx = int(localRay % uint(octRes));
    int dy = int(localRay / uint(octRes));

    uint key = slotToKey[slot];
    ivec3 cell = unpackCellKey(key);
    vec3 worldPos = probeWorldPos(cell, pc.worldOriginSpacing.xyz, pc.worldOriginSpacing.w);

    int storageBase = probeStorageBase(slot, octRes);

    vec2 uv = octIndexToUV(ivec2(dx, dy), octRes);
    vec3 dir = octDecode(uv);

    Ray ray;
    ray.origin = worldPos;
    ray.direction = dir;
    ray.tMin = pc.intervalStart + 0.001;
    ray.tMax = pc.intervalEnd;

    vec3 radiance = vec3(0.0);
    float transmittance = 1.0;

    // --- 1. Analytical nearest hit: planes then quads ---
    float analytT = pc.intervalEnd;
    int analytMat = -1;
    vec3 analytN = vec3(0.0);

    for (int i = 0; i < pc.planeCount; i++) {
        float denom = dot(planes[i].normal, dir);
        if (abs(denom) < 1e-6) continue;
        float t = dot(planes[i].center - worldPos, planes[i].normal) / denom;
        if (t > ray.tMin && t < analytT) {
            analytT   = t;
            analytMat = planes[i].materialIndex;
            analytN   = (denom < 0.0) ? planes[i].normal : -planes[i].normal;
        }
    }
    for (int i = 0; i < pc.quadCount; i++) {
        float denom = dot(quads[i].normalVector, dir);
        if (abs(denom) < 1e-6) continue;
        float t = dot(quads[i].corner - worldPos, quads[i].normalVector) / denom;
        if (t <= ray.tMin || t >= analytT) continue;
        vec3 p = worldPos + dir * t - quads[i].corner;
        float e1l2 = dot(quads[i].edge1, quads[i].edge1);
        float e2l2 = dot(quads[i].edge2, quads[i].edge2);
        float qu = dot(p, quads[i].edge1) / e1l2;
        float qv = dot(p, quads[i].edge2) / e2l2;
        if (qu < 0.0 || qu > 1.0 || qv < 0.0 || qv > 1.0) continue;
        analytT = t;
        analytMat = quads[i].materialIndex;
        analytN = (denom < 0.0) ? quads[i].normalVector : -quads[i].normalVector;
    }

    // --- 2. BVH traversal capped at the analytical hit ---
    ray.tMax = analytT;
    HitInfo bvhHit;
    bool bvhResult = traverseBVH(ray, pc.bvhCount, bvhHit);

    // --- 3. Nearest overall hit ---
    bool didHit = bvhResult || (analytMat >= 0);
    float hitT = bvhResult ? bvhHit.t : analytT;
    vec3 hitN = bvhResult ? bvhHit.normal : analytN;
    int hitMat = bvhResult ? bvhHit.materialIndex : analytMat;
    vec3 hitPos = worldPos + dir * hitT;

    // --- 4. Radiance at hit surface ---
    // Cascade-0: emission + BVH-shadowed single-bounce direct. Shadow is baked into the
    // probe so the gather pass can drop its per-pixel BVH shadow calls (18x fewer rays).
    // Cascade 1+: emission only — receives light through cascade merging (SRC paper design).
    if (didHit) {
        GPUMaterial mat = materials[hitMat];
        radiance = mat.emission;
        transmittance = 0.0;

        if (pc.evaluateDirect != 0) {
            // Base color only — no texture lookup for probe rays (GI is low-frequency)
            vec3 albedo = mat.color;

            for (int l = 0; l < pc.lightCount; l++) {
                vec3  toLight = lights[l].position - hitPos;
                float lightDist = length(toLight);
                vec3  lightDir = toLight / lightDist;
                float NdotL = max(0.0, dot(hitN, lightDir));
                if (NdotL < 0.001) continue;

                vec3 shadowOrigin = hitPos + hitN * 0.001;
                float shadowMaxT = lightDist - 0.01;

                // Shadow evaluation — two paths sharing the same condition.
                // Backup: set softShadowSamples = 1 (slider) to restore original hard-shadow behavior exactly.
                vec3 shadowAtten;
                if (pc.softShadowSamples <= 1 || lights[l].radius < 0.0001) {
                    // --- Original hard shadow path (unchanged) ---
                    shadowAtten = vec3(1.0);
                    for (int i = 0; i < pc.planeCount; i++) {
                        float denom = dot(planes[i].normal, lightDir);
                        if (abs(denom) < 1e-6) continue;
                        float t = dot(planes[i].center - shadowOrigin, planes[i].normal) / denom;
                        if (t <= 0.001 || t >= shadowMaxT) continue;
                        GPUMaterial smat = materials[planes[i].materialIndex];
                        if (smat.castShadows == 0) continue;
                        if (smat.transparency > 0.01) { shadowAtten *= smat.color * smat.transparency; }
                        else { shadowAtten = vec3(0.0); break; }
                    }
                    if (dot(shadowAtten, shadowAtten) > 0.001) {
                        for (int i = 0; i < pc.quadCount; i++) {
                            float denom = dot(quads[i].normalVector, lightDir);
                            if (abs(denom) < 1e-6) continue;
                            float t = dot(quads[i].corner - shadowOrigin, quads[i].normalVector) / denom;
                            if (t <= 0.001 || t >= shadowMaxT) continue;
                            vec3  p    = shadowOrigin + lightDir * t - quads[i].corner;
                            float e1l2 = dot(quads[i].edge1, quads[i].edge1);
                            float e2l2 = dot(quads[i].edge2, quads[i].edge2);
                            float qu   = dot(p, quads[i].edge1) / e1l2;
                            float qv   = dot(p, quads[i].edge2) / e2l2;
                            if (qu < 0.0 || qu > 1.0 || qv < 0.0 || qv > 1.0) continue;
                            GPUMaterial smat = materials[quads[i].materialIndex];
                            if (smat.castShadows == 0) continue;
                            if (smat.transparency > 0.01) { shadowAtten *= smat.color * smat.transparency; }
                            else { shadowAtten = vec3(0.0); break; }
                        }
                    }
                    if (dot(shadowAtten, shadowAtten) > 0.001) {
                        Ray sr;
                        sr.origin    = shadowOrigin;
                        sr.direction = lightDir;
                        sr.tMin      = 0.001;
                        sr.tMax      = shadowMaxT;
                        shadowAtten *= traverseBVHShadow(sr, pc.bvhCount);
                    }
                } else {
                    // --- Unified soft shadow: N samples test the same jittered direction for
                    // planes, quads, and BVH — consistent penumbras across all occluder types.
                    // Seeded from stable cell key: same probe/direction/light/sample = same jitter
                    // every frame, so soft shadows are baked with no temporal flicker.
                    shadowAtten = vec3(0.0);
                    for (int s = 0; s < pc.softShadowSamples; s++) {
                        randState = key * 97u + uint(localRay) * 53u + uint(l) * 17u + uint(s) * 7u;
                        vec3  jitter  = vec3(rand() * 2.0 - 1.0, rand() * 2.0 - 1.0, rand() * 2.0 - 1.0)
                                        * lights[l].radius;
                        vec3  jitToL  = toLight + jitter;
                        float jitDist = length(jitToL);
                        vec3  jitDir  = jitToL / jitDist;
                        float jitMaxT = jitDist - 0.01;

                        vec3 sampleAtten = vec3(1.0);
                        for (int i = 0; i < pc.planeCount; i++) {
                            float denom = dot(planes[i].normal, jitDir);
                            if (abs(denom) < 1e-6) continue;
                            float t = dot(planes[i].center - shadowOrigin, planes[i].normal) / denom;
                            if (t <= 0.001 || t >= jitMaxT) continue;
                            GPUMaterial smat = materials[planes[i].materialIndex];
                            if (smat.castShadows == 0) continue;
                            if (smat.transparency > 0.01) { sampleAtten *= smat.color * smat.transparency; }
                            else { sampleAtten = vec3(0.0); break; }
                        }
                        if (dot(sampleAtten, sampleAtten) > 0.001) {
                            for (int i = 0; i < pc.quadCount; i++) {
                                float denom = dot(quads[i].normalVector, jitDir);
                                if (abs(denom) < 1e-6) continue;
                                float t = dot(quads[i].corner - shadowOrigin, quads[i].normalVector) / denom;
                                if (t <= 0.001 || t >= jitMaxT) continue;
                                vec3  p    = shadowOrigin + jitDir * t - quads[i].corner;
                                float e1l2 = dot(quads[i].edge1, quads[i].edge1);
                                float e2l2 = dot(quads[i].edge2, quads[i].edge2);
                                float qu   = dot(p, quads[i].edge1) / e1l2;
                                float qv   = dot(p, quads[i].edge2) / e2l2;
                                if (qu < 0.0 || qu > 1.0 || qv < 0.0 || qv > 1.0) continue;
                                GPUMaterial smat = materials[quads[i].materialIndex];
                                if (smat.castShadows == 0) continue;
                                if (smat.transparency > 0.01) { sampleAtten *= smat.color * smat.transparency; }
                                else { sampleAtten = vec3(0.0); break; }
                            }
                        }
                        if (dot(sampleAtten, sampleAtten) > 0.001) {
                            Ray sr;
                            sr.origin    = shadowOrigin;
                            sr.direction = jitDir;
                            sr.tMin      = 0.001;
                            sr.tMax      = jitMaxT;
                            sampleAtten *= traverseBVHShadow(sr, pc.bvhCount);
                        }
                        shadowAtten += sampleAtten;
                    }
                    shadowAtten /= float(pc.softShadowSamples);
                }

                if (dot(shadowAtten, shadowAtten) < 0.001) continue;

                float atten = 1.0 / max(lightDist * lightDist, 0.01);
                radiance += albedo * mat.diffuse * NdotL * lights[l].color * atten * shadowAtten;
            }
        }
    }
    // miss: radiance = 0, transmittance = 1 (probe samples parent cascade at merge)

    int idx = storageBase + dy * octRes + dx;
    cascadeData[idx] = packRadianceTransmittance(radiance, transmittance);
}
