#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable
layout(local_size_x = 16, local_size_y = 16) in;

// Scene-only includes first (no SSBO references, safe anywhere)
#include "../common/ray.glsl"
#include "../common/bvh.glsl"
#include "../common/material.glsl"
#include "../common/lighting.glsl"
#include "../common/shadow.glsl"
#include "../common/octahedral.glsl"
#include "../common/caustics.glsl"

// G-buffer (set 1 = gbufDescSet)
// Set 0 is reserved for sceneDescSetLayout so that bvh.glsl/lighting.glsl
// SSBOs (which hardcode set=0) resolve correctly.
layout(set = 1, binding = 0, rgba32f) uniform readonly image2D gPosition;
layout(set = 1, binding = 1, rgba16f) uniform readonly image2D gNormal;
layout(set = 1, binding = 2, rgba8) uniform readonly image2D gAlbedo;
layout(set = 1, binding = 3, rgba16f) uniform readonly image2D gEmissive;
layout(set = 1, binding = 5, rgba16f) uniform writeonly image2D outHDR;

// Cascade 0 hash + data (set 2 = rcHashDescSets[0])
layout(std430, set = 2, binding = 0) readonly buffer HK  { uint hashKeys[];    };
layout(std430, set = 2, binding = 1) readonly buffer HV  { uint hashValues[];  };
layout(std430, set = 2, binding = 2) readonly buffer STK { uint slotToKey[];   };
layout(std430, set = 2, binding = 3) readonly buffer SC  { uint nextSlot;      };
layout(std430, set = 2, binding = 4) readonly buffer CD  { uvec2 cascadeData[]; };
// b5 = parentCascadeData (not used in gather)
layout(std430, set = 2, binding = 6) readonly buffer SH  { vec4 shCoeffs[];    };

// Planes and quads live in sceneDescSetLayout (set 0) at bindings 5 and 6.
struct GPUPlane {
    vec3 center; float p1;
    vec3 normal; int  materialIndex;
    float p2; float p3; float p4; float p5;
};
struct GPUQuad {
    vec3 corner;       float p1;
    vec3 edge1;        float p2;
    vec3 edge2;        float p3;
    vec3 normalVector; int   materialIndex;
    float p4; float p5; float p6; float p7;
};
layout(std430, set = 0, binding = 5) readonly buffer PlaneBuffer { GPUPlane planes[]; };
layout(std430, set = 0, binding = 6) readonly buffer QuadBuffer  { GPUQuad  quads[];  };

// cascade_layout.glsl MUST come after all SSBO declarations it references
#include "../common/cascade_layout.glsl"

layout(push_constant) uniform GatherPC {
    vec4 worldOriginSpacing;    // xyz = worldOrigin, w = cascade-0 spacing
    ivec4 gridSizeOctRes;       // xyz = cascade-0 gridSize, w = cascade-0 octRes
    vec4 camPos;                // xyz = camera world position for viewDir/specular
    int hashSize;
    int bvhCount;
    int lightCount;
    int planeCount;
    int quadCount;
    int debugMode;              // 0=Final 1=Albedo 2=Normal 3=Depth 4=Emissive 5=IndirectOnly
    int enableDirect;
    int enableIndirect;
    vec4 skyBottomColor;        // xyz = horizon sky color
    vec4 skyTopColor;           // xyz = zenith sky color
    float kIndirectScale;       // GI irradiance → color scale
    float fogDensity;           // exponential fog decay coefficient
    int fogBlendWithSky;        // 1 = fog samples sky gradient; 0 = no fog applied
    int pad;
    int enableCaustics;
    int totalEmittedPhotons;
    float causticIntensity;
    float gatherRadius;
    vec4 gridMin;
    vec4 gridMax;
    int gridRes;
} pc;

// Returns vec3(1) if unoccluded, vec3(0) if fully blocked, tinted vec3 for transparent hits.
vec3 analyticalShadow(vec3 origin, vec3 dir, float maxT) {
    vec3 atten = vec3(1.0);
    for (int i = 0; i < pc.planeCount; i++) {
        float denom = dot(planes[i].normal, dir);
        if (abs(denom) < 1e-6) continue;
        float t = dot(planes[i].center - origin, planes[i].normal) / denom;
        if (t <= 0.001 || t >= maxT) continue;
        GPUMaterial mat = materials[planes[i].materialIndex];
        if (mat.castShadows == 0) continue;
        if (mat.transparency > 0.01) { atten *= mat.color * mat.transparency; }
        else return vec3(0.0);
    }
    for (int i = 0; i < pc.quadCount; i++) {
        float denom = dot(quads[i].normalVector, dir);
        if (abs(denom) < 1e-6) continue;
        float t = dot(quads[i].corner - origin, quads[i].normalVector) / denom;
        if (t <= 0.001 || t >= maxT) continue;
        vec3 p = origin + dir * t - quads[i].corner;
        float e1l2 = dot(quads[i].edge1, quads[i].edge1);
        float e2l2 = dot(quads[i].edge2, quads[i].edge2);
        float qu = dot(p, quads[i].edge1) / e1l2;
        float qv = dot(p, quads[i].edge2) / e2l2;
        if (qu < 0.0 || qu > 1.0 || qv < 0.0 || qv > 1.0) continue;
        GPUMaterial mat = materials[quads[i].materialIndex];
        if (mat.castShadows == 0) continue;
        if (mat.transparency > 0.01) { atten *= mat.color * mat.transparency; }
        else return vec3(0.0);
    }
    return atten;
}

// SH L0+L1 probe irradiance: 4 reads + dot-product vs the old 16-iteration loop.
// Calibrated to match the original Monte Carlo estimate scale (K0=π/2N, K1=3π/2N).
vec3 sampleProbeIrradiance(uint slot, vec3 normal) {
    int base4 = int(slot) * 4;
    vec3 sh0 = shCoeffs[base4 + 0].rgb;
    vec3 sh1 = shCoeffs[base4 + 1].rgb;
    vec3 sh2 = shCoeffs[base4 + 2].rgb;
    vec3 sh3 = shCoeffs[base4 + 3].rgb;
    vec3 result = sh0 + sh1 * normal.x + sh2 * normal.y + sh3 * normal.z;
    // Soft floor at 10% of L0 (Geomerics-style): prevents back-facing surfaces from going black
    // while still preserving full clamping for truly unlit probes.
    return max(result, sh0 * 0.1);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outHDR);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec4 emissiveData = imageLoad(gEmissive, pixel);

    // Sky pixels are flagged with negative alpha in gEmissive (set by primary.comp)
    if (emissiveData.a < 0.0) {
        imageStore(outHDR, pixel, vec4(emissiveData.rgb, 1.0));
        return;
    }

    vec3 worldPos = imageLoad(gPosition, pixel).xyz;
    vec4 normalData = imageLoad(gNormal, pixel);
    vec4 albedoData = imageLoad(gAlbedo, pixel);
    vec3 normal = normalize(normalData.xyz);
    vec3 albedo = albedoData.rgb;
    float roughness = normalData.w;
    float metallic = albedoData.w;

    // Read the full material so we can access ambient, specular, shadingModel, etc.
    int matIdx = int(round(emissiveData.a));
    GPUMaterial mat = materials[matIdx];
    mat.roughness = roughness;  // prefer G-buffer values (will reflect texture maps once added)
    mat.metallic = metallic;

    // View direction for specular (camera position is passed in push constant)
    vec3 viewDir = normalize(pc.camPos.xyz - worldPos);

    // Debug visualization early returns (bypass GI pipeline entirely)
    if (pc.debugMode == 1) { imageStore(outHDR, pixel, vec4(albedo, 1.0)); return; }
    if (pc.debugMode == 2) { imageStore(outHDR, pixel, vec4(normal * 0.5 + 0.5, 1.0)); return; }
    if (pc.debugMode == 3) {
        float depth = length(worldPos - pc.camPos.xyz) * 0.05;
        imageStore(outHDR, pixel, vec4(vec3(depth), 1.0)); return;
    }
    if (pc.debugMode == 4) { imageStore(outHDR, pixel, vec4(emissiveData.rgb, 1.0)); return; }

    // --- Indirect light: trilinear interpolation over 8 surrounding cascade-0 probes ---
    //
    // Trilinear interpolation: the surface point is surrounded by 8 probe cells arranged
    // at the corners of a unit cube in "cascade space" (world coords / spacing - 0.5).
    // Each of the 8 probes gets a weight = wx * wy * wz where each w is a linear blend
    // factor (1-f or f) for that axis.  The sum of all 8 weights = 1.0 when all probes
    // exist, giving a smooth interpolation with no seams between probe cells.
    //
    // When probes are available: albedo * probeIrradiance * kIndirectScale.
    // When probes are absent or indirect is disabled: albedo * mat.ambient (constant fill).
    // The two paths use different scales because probe irradiance magnitudes are ~1000x mat.ambient.
    vec3 indirect  = vec3(0.0);
    bool hasProbes = false;
    if (pc.enableIndirect != 0) {
        // Convert world position to fractional probe grid coordinates.
        // The -0.5 offset aligns grid cells with probe alloc (floor(pos/spacing - 0.5)).
        vec3 cascadeSpace = (worldPos - pc.worldOriginSpacing.xyz) / pc.worldOriginSpacing.w - 0.5;
        ivec3 base = ivec3(floor(cascadeSpace));    // integer coords of the "base" corner
        vec3 f = cascadeSpace - vec3(base);         // fractional offset inside the cell [0,1]^3

        float weightSum = 0.0;

        // Iterate over 8 corner probes (px,py,pz in {0,1}).
        for (int pz = 0; pz <= 1; pz++) {
            for (int py = 0; py <= 1; py++) {
                for (int px = 0; px <= 1; px++) {
                    ivec3 probe = base + ivec3(px, py, pz);
                    if (any(lessThan(probe, ivec3(0))) ||
                        any(greaterThanEqual(probe, pc.gridSizeOctRes.xyz))) continue;

                    uint pKey = packCellKey(probe);
                    uint pSlot = probeLookup(pKey, uint(pc.hashSize));
                    if (pSlot == 0xFFFFFFFFu) continue;  // probe not allocated this frame

                    // Trilinear weight: for each axis, the "0" corner gets (1-f), the "1" corner gets f.
                    float wx = (px == 0) ? (1.0 - f.x) : f.x;
                    float wy = (py == 0) ? (1.0 - f.y) : f.y;
                    float wz = (pz == 0) ? (1.0 - f.z) : f.z;
                    // DDGI backface weight: deprioritise probes that are behind the shading surface.
                    // Prevents probes on the far side of a wall from leaking through geometry.
                    vec3 toProbe = (vec3(probe) + 0.5) * pc.worldOriginSpacing.w
                                 + pc.worldOriginSpacing.xyz - worldPos;
                    float wrapShading = (dot(normalize(toProbe), normal) + 1.0) * 0.5;
                    float w = wx * wy * wz * (wrapShading * wrapShading + 0.2);

                    indirect += sampleProbeIrradiance(pSlot, normal) * w;
                    weightSum += w;
                }
            }
        }

        if (weightSum > 0.001) {
            indirect /= weightSum;
            hasProbes = true;
        } else {
            // No probes in standard stencil — widen to 3×3×3 neighborhood (±1 cell).
            for (int fz = -1; fz <= 1; fz++)
            for (int fy = -1; fy <= 1; fy++)
            for (int fx = -1; fx <= 1; fx++) {
                ivec3 fp = base + ivec3(fx, fy, fz);
                if (any(lessThan(fp, ivec3(0))) || any(greaterThanEqual(fp, pc.gridSizeOctRes.xyz))) continue;
                uint fSlot = probeLookup(packCellKey(fp), uint(pc.hashSize));
                if (fSlot == 0xFFFFFFFFu) continue;
                indirect += sampleProbeIrradiance(fSlot, normal);
                weightSum += 1.0;
            }
            if (weightSum > 0.001) { indirect /= weightSum; hasProbes = true; }
        }
    }

    // When probes exist use their irradiance directly; ambient is only a tiny safety floor
    // (was clamped to mat.ambient = 0.1 which drowned any colored indirect signal).
    vec3 indirectContrib = hasProbes
        ? albedo * max(indirect * pc.kIndirectScale, vec3(mat.ambient * 0.05))
        : albedo * mat.ambient;
    // Mode 5: raw probe irradiance bypassing the ambient clamp.
    // Black = no probe allocated here. Use this + Indirect Scale slider to diagnose GI.
    if (pc.debugMode == 5) {
        vec3 rawGI = hasProbes ? albedo * indirect * pc.kIndirectScale : vec3(0.0);
        imageStore(outHDR, pixel, vec4(rawGI, 1.0));
        return;
    }

    // --- Direct lighting: emissive + PBR/Blinn-Phong per light ---
    vec3 directLight = emissiveData.rgb;

    if (pc.enableDirect != 0) {
    for (int l = 0; l < pc.lightCount; l++) {
        vec3  toLight   = lights[l].position - worldPos;
        vec3  lightDir  = normalize(toLight);
        float lightDist = length(toLight);

        Ray shadowRay;
        shadowRay.origin = worldPos + normal * 0.001;
        shadowRay.direction = lightDir;
        shadowRay.tMin = 0.001;
        shadowRay.tMax = lightDist - 0.01;

        // Analytical shadow first (planes + quads); BVH shadow for mesh occlusion (doughnut etc.).
        vec3 shadowAtten = analyticalShadow(shadowRay.origin, shadowRay.direction, shadowRay.tMax);
        if (dot(shadowAtten, shadowAtten) > 0.001) {
            shadowAtten *= traverseBVHShadow(shadowRay, pc.bvhCount);
        }
        if (dot(shadowAtten, shadowAtten) > 0.001) {
            float atten = 1.0 / max(lightDist * lightDist, 0.01);
            vec3  attenuatedLight = lights[l].color * shadowAtten * atten;

            if (mat.shadingModel == 1) {
                directLight += pbrShading(mat, albedo, normal, viewDir, lightDir, attenuatedLight);
            } else {
                directLight += lambertianShading(mat, albedo, normal, lightDir, attenuatedLight);
                directLight += blingPhongShading(mat, attenuatedLight, normal, lightDir, viewDir, 50.0);
            }
        }
    }
    } // enableDirect

    // Caustics check
    vec3 causticsContrib = vec3(0.0);
    if (pc.enableCaustics == 1 && mat.transparency == 0.0 && mat.reflection == 0.0) {
        vec3 caustics = gatherPhotons(worldPos, normal, pc.gridMin.xyz, pc.gridMax.xyz, pc.gridRes, pc.totalEmittedPhotons, pc.gatherRadius, pc.causticIntensity);
        causticsContrib = caustics * albedo * mat.diffuse;
    }

    vec3 color = directLight + indirectContrib + causticsContrib;

    // Fog and first-order reflections are handled by reflection.comp (next pass).
    // That pass reads this outHDR value, applies fog + reflection blend for all geometry pixels.
    imageStore(outHDR, pixel, vec4(color, 1.0));
}
