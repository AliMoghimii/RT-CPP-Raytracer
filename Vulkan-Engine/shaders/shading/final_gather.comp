#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable
layout(local_size_x = 16, local_size_y = 16) in;

// Scene-only includes first (no SSBO references, safe anywhere)
#include "../common/ray.glsl"
#include "../common/bvh.glsl"
#include "../common/material.glsl"
#include "../common/lighting.glsl"
#include "../common/shadow.glsl"
#include "../common/octahedral.glsl"

// G-buffer (set 1 = gbufDescSet)
// Set 0 is reserved for sceneDescSetLayout so that bvh.glsl/lighting.glsl
// SSBOs (which hardcode set=0) resolve correctly.
layout(set = 1, binding = 0, rgba32f) uniform readonly image2D gPosition;
layout(set = 1, binding = 1, rgba16f) uniform readonly image2D gNormal;
layout(set = 1, binding = 2, rgba8) uniform readonly image2D gAlbedo;
layout(set = 1, binding = 3, rgba16f) uniform readonly image2D gEmissive;
layout(set = 1, binding = 5, rgba16f) uniform writeonly image2D outHDR;

// Cascade 0 hash + data (set 2 = rcHashDescSets[0])
layout(std430, set = 2, binding = 0) readonly buffer HK  { uint hashKeys[];    };
layout(std430, set = 2, binding = 1) readonly buffer HV  { uint hashValues[];  };
layout(std430, set = 2, binding = 2) readonly buffer STK { uint slotToKey[];   };
layout(std430, set = 2, binding = 3) readonly buffer SC  { uint nextSlot;      };
layout(std430, set = 2, binding = 4) readonly buffer CD  { uvec2 cascadeData[]; };
// b5 = parentCascadeData (not used in gather)

// Planes and quads live in sceneDescSetLayout (set 0) at bindings 5 and 6.
// Declaring them here gives the reflection pass access to all analytical geometry.
struct GPUPlane {
    vec3 center; float p1;
    vec3 normal; int  materialIndex;
    float p2; float p3; float p4; float p5;
};
struct GPUQuad {
    vec3 corner;       float p1;
    vec3 edge1;        float p2;
    vec3 edge2;        float p3;
    vec3 normalVector; int   materialIndex;
    float p4; float p5; float p6; float p7;
};
layout(std430, set = 0, binding = 5) readonly buffer PlaneBuffer { GPUPlane planes[]; };
layout(std430, set = 0, binding = 6) readonly buffer QuadBuffer  { GPUQuad  quads[];  };

// cascade_layout.glsl MUST come after all SSBO declarations it references
// (hashKeys, hashValues, slotToKey, nextSlot, cascadeData). No #define needed here
// — this is a read-only pass that only uses probeLookup() and helpers.
#include "../common/cascade_layout.glsl"

layout(push_constant) uniform GatherPC {
    vec4  worldOriginSpacing;   // xyz = worldOrigin, w = cascade-0 spacing
    ivec4 gridSizeOctRes;       // xyz = cascade-0 gridSize, w = cascade-0 octRes
    vec4  camPos;               // xyz = camera world position for viewDir/specular
    int hashSize;
    int bvhCount;
    int lightCount;
    int planeCount;
    int quadCount;
    int debugMode;    // 0=Final 1=Albedo 2=Normal 3=Depth 4=Emissive
    int enableDirect;
    int enableIndirect;
    vec4 skyBottomColor;        // xyz = horizon sky color
    vec4 skyTopColor;           // xyz = zenith sky color
    float kIndirectScale;       // GI irradiance → color scale
    float fogDensity;           // exponential fog decay coefficient
    int fogBlendWithSky;        // 1 = fog samples sky gradient; 0 = no fog applied
    int pad;
} pc;

// Returns vec3(1) if unoccluded, vec3(0) if fully blocked, tinted vec3 for transparent hits.
vec3 analyticalShadow(vec3 origin, vec3 dir, float maxT) {
    vec3 atten = vec3(1.0);
    for (int i = 0; i < pc.planeCount; i++) {
        float denom = dot(planes[i].normal, dir);
        if (abs(denom) < 1e-6) continue;
        float t = dot(planes[i].center - origin, planes[i].normal) / denom;
        if (t <= 0.001 || t >= maxT) continue;
        GPUMaterial mat = materials[planes[i].materialIndex];
        if (mat.castShadows == 0) continue;
        if (mat.transparency > 0.01) { atten *= mat.color * mat.transparency; }
        else return vec3(0.0);
    }
    for (int i = 0; i < pc.quadCount; i++) {
        float denom = dot(quads[i].normalVector, dir);
        if (abs(denom) < 1e-6) continue;
        float t = dot(quads[i].corner - origin, quads[i].normalVector) / denom;
        if (t <= 0.001 || t >= maxT) continue;
        vec3  p    = origin + dir * t - quads[i].corner;
        float e1l2 = dot(quads[i].edge1, quads[i].edge1);
        float e2l2 = dot(quads[i].edge2, quads[i].edge2);
        float qu   = dot(p, quads[i].edge1) / e1l2;
        float qv   = dot(p, quads[i].edge2) / e2l2;
        if (qu < 0.0 || qu > 1.0 || qv < 0.0 || qv > 1.0) continue;
        GPUMaterial mat = materials[quads[i].materialIndex];
        if (mat.castShadows == 0) continue;
        if (mat.transparency > 0.01) { atten *= mat.color * mat.transparency; }
        else return vec3(0.0);
    }
    return atten;
}

// Integrate all directions in cascade 0's probe against the surface normal.
// Returns the diffuse irradiance arriving at the probe position from that hemisphere.
vec3 sampleProbeIrradiance(uint slot, vec3 normal) {
    int octRes = pc.gridSizeOctRes.w;
    int storageBase = probeStorageBase(slot, octRes);
    int dirCount = octRes * octRes;
    vec3 irradiance = vec3(0.0);

    for (int d = 0; d < dirCount; d++) {
        int dx = d % octRes;
        int dy = d / octRes;
        vec2 uv = octIndexToUV(ivec2(dx, dy), octRes);
        vec3 dir = octDecode(uv);

        float NdotL = max(0.0, dot(dir, normal));
        if (NdotL < 0.001) continue;

        vec4 interval = unpackRadianceTransmittance(cascadeData[storageBase + d]);
        irradiance += interval.rgb * NdotL;
    }

    // Monte Carlo normalization: hemisphere solid angle (2π) divided by sample count.
    // This converts the sum of weighted radiance samples into irradiance.
    return irradiance * (2.0 * 3.14159265 / float(dirCount));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outHDR);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec4 emissiveData = imageLoad(gEmissive, pixel);

    // Sky pixels are flagged with negative alpha in gEmissive (set by primary.comp)
    if (emissiveData.a < 0.0) {
        imageStore(outHDR, pixel, vec4(emissiveData.rgb, 1.0));
        return;
    }

    vec3 worldPos = imageLoad(gPosition, pixel).xyz;
    vec4 normalData = imageLoad(gNormal, pixel);
    vec4 albedoData = imageLoad(gAlbedo, pixel);
    vec3 normal  = normalize(normalData.xyz);
    vec3 albedo  = albedoData.rgb;
    float roughness = normalData.w;
    float metallic  = albedoData.w;

    // Read the full material so we can access ambient, specular, shadingModel, etc.
    int matIdx = int(round(emissiveData.a));
    GPUMaterial mat = materials[matIdx];
    mat.roughness = roughness;  // prefer G-buffer values (will reflect texture maps once added)
    mat.metallic  = metallic;

    // View direction for specular (camera position is passed in push constant)
    vec3 viewDir = normalize(pc.camPos.xyz - worldPos);

    // Debug visualization early returns (bypass GI pipeline entirely)
    if (pc.debugMode == 1) { imageStore(outHDR, pixel, vec4(albedo, 1.0)); return; }
    if (pc.debugMode == 2) { imageStore(outHDR, pixel, vec4(normal * 0.5 + 0.5, 1.0)); return; }
    if (pc.debugMode == 3) {
        float depth = length(worldPos - pc.camPos.xyz) * 0.05;
        imageStore(outHDR, pixel, vec4(vec3(depth), 1.0)); return;
    }
    if (pc.debugMode == 4) { imageStore(outHDR, pixel, vec4(emissiveData.rgb, 1.0)); return; }

    // --- Indirect light: trilinear interpolation over 8 surrounding cascade-0 probes ---
    // When probes are available: albedo * probeIrradiance * kIndirectScale.
    // When probes are absent or indirect is disabled: albedo * mat.ambient (original constant fill).
    // The two paths use different scales because probe irradiance magnitudes are ~1000× mat.ambient.
    vec3 indirect  = vec3(0.0);
    bool hasProbes = false;
    if (pc.enableIndirect != 0) {
        vec3 cascadeSpace = (worldPos - pc.worldOriginSpacing.xyz) / pc.worldOriginSpacing.w - 0.5;
        ivec3 base = ivec3(floor(cascadeSpace));
        vec3 f = cascadeSpace - vec3(base);

        float weightSum = 0.0;

        for (int pz = 0; pz <= 1; pz++) {
            for (int py = 0; py <= 1; py++) {
                for (int px = 0; px <= 1; px++) {
                    ivec3 probe = base + ivec3(px, py, pz);
                    if (any(lessThan(probe, ivec3(0))) ||
                        any(greaterThanEqual(probe, pc.gridSizeOctRes.xyz))) continue;

                    uint pKey = packCellKey(probe);
                    uint pSlot = probeLookup(pKey, uint(pc.hashSize));
                    if (pSlot == 0xFFFFFFFFu) continue; // probe not active this frame

                    float wx = (px == 0) ? (1.0 - f.x) : f.x;
                    float wy = (py == 0) ? (1.0 - f.y) : f.y;
                    float wz = (pz == 0) ? (1.0 - f.z) : f.z;
                    float w = wx * wy * wz;

                    indirect  += sampleProbeIrradiance(pSlot, normal) * w;
                    weightSum += w;
                }
            }
        }

        if (weightSum > 0.001) {
            indirect /= weightSum;
            hasProbes = true;
        } else {
            // No probes in standard stencil — widen to 5×5×5 neighborhood (±2 cells).
            // Covers gaps up to 2 spacings away, needed for curved transparent objects
            // (e.g., glass sphere back face is ~diameter/spacing cells from front probes).
            for (int fz = -2; fz <= 2; fz++)
            for (int fy = -2; fy <= 2; fy++)
            for (int fx = -2; fx <= 2; fx++) {
                ivec3 fp = base + ivec3(fx, fy, fz);
                if (any(lessThan(fp, ivec3(0))) || any(greaterThanEqual(fp, pc.gridSizeOctRes.xyz))) continue;
                uint fSlot = probeLookup(packCellKey(fp), uint(pc.hashSize));
                if (fSlot == 0xFFFFFFFFu) continue;
                indirect  += sampleProbeIrradiance(fSlot, normal);
                weightSum += 1.0;
            }
            if (weightSum > 0.001) { indirect /= weightSum; hasProbes = true; }
        }
    }

    // --- Direct lighting: emissive + PBR/Blinn-Phong per light ---
    vec3 directLight = emissiveData.rgb;

    if (pc.enableDirect != 0) {
    for (int l = 0; l < pc.lightCount; l++) {
        vec3  toLight   = lights[l].position - worldPos;
        vec3  lightDir  = normalize(toLight);
        float lightDist = length(toLight);

        Ray shadowRay;
        shadowRay.origin    = worldPos + normal * 0.001;
        shadowRay.direction = lightDir;
        shadowRay.tMin      = 0.001;
        shadowRay.tMax      = lightDist - 0.01;

        vec3 shadowAtten = analyticalShadow(shadowRay.origin, shadowRay.direction, shadowRay.tMax);
        if (dot(shadowAtten, shadowAtten) > 0.001) {
            shadowAtten *= traverseBVHShadow(shadowRay, pc.bvhCount);
            if (dot(shadowAtten, shadowAtten) > 0.001) {
                float atten          = 1.0 / max(lightDist * lightDist, 0.01);
                vec3  attenuatedLight = lights[l].color * shadowAtten * atten;

                if (mat.shadingModel == 1) {
                    directLight += pbrShading(mat, albedo, normal, viewDir, lightDir, attenuatedLight);
                } else {
                    directLight += lambertianShading(mat, albedo, normal, lightDir, attenuatedLight);
                    directLight += blingPhongShading(mat, attenuatedLight, normal, lightDir, viewDir, 50.0);
                }
            }
        }
    }
    } // enableDirect

    // Final color: direct + indirect.
    // With probe data: albedo × probeIrradiance × kIndirectScale (GI path).
    // Without probe data: albedo × mat.ambient (original constant-fill fallback).
    vec3 indirectContrib = hasProbes
        ? albedo * max(indirect * pc.kIndirectScale, vec3(mat.ambient))
        : albedo * mat.ambient;
    vec3 color = directLight + indirectContrib;

    // --- First-order reflections ---
    // Shoots one reflection ray per pixel when mat.reflection > 0.
    // Tests analytical geometry (planes, quads) first, then BVH (spheres + triangles).
    // Blends: color = shadedColor * (1 - R) + reflectedColor * R
    if (mat.reflection > 0.01) {
        vec3 reflDir = reflect(-viewDir, normal);

        float reflT      = 1e6;
        int   reflMatIdx = -1;
        vec3  reflNormal = vec3(0.0);
        bool  reflIsBVH  = false;
        vec2  reflUV     = vec2(0.0);

        // Analytical planes
        for (int i = 0; i < pc.planeCount; i++) {
            float denom = dot(planes[i].normal, reflDir);
            if (abs(denom) < 1e-6) continue;
            float t = dot(planes[i].center - worldPos, planes[i].normal) / denom;
            if (t > 0.001 && t < reflT) {
                reflT = t; reflMatIdx = planes[i].materialIndex;
                reflNormal = (denom < 0.0) ? planes[i].normal : -planes[i].normal;
                reflIsBVH  = false;
            }
        }

        // Analytical quads
        for (int i = 0; i < pc.quadCount; i++) {
            float denom = dot(quads[i].normalVector, reflDir);
            if (abs(denom) < 1e-6) continue;
            float t = dot(quads[i].corner - worldPos, quads[i].normalVector) / denom;
            if (t <= 0.001 || t >= reflT) continue;
            vec3  p    = worldPos + reflDir * t - quads[i].corner;
            float e1l2 = dot(quads[i].edge1, quads[i].edge1);
            float e2l2 = dot(quads[i].edge2, quads[i].edge2);
            float qu   = dot(p, quads[i].edge1) / e1l2;
            float qv   = dot(p, quads[i].edge2) / e2l2;
            if (qu < 0.0 || qu > 1.0 || qv < 0.0 || qv > 1.0) continue;
            reflT = t; reflMatIdx = quads[i].materialIndex;
            reflNormal = (denom < 0.0) ? quads[i].normalVector : -quads[i].normalVector;
            reflIsBVH  = false;
        }

        // BVH (tessellated spheres + triangles)
        Ray reflRay;
        reflRay.origin    = worldPos + normal * 0.002;
        reflRay.direction = reflDir;
        reflRay.tMin      = 0.001;
        reflRay.tMax      = reflT;
        HitInfo reflHit;
        if (traverseBVH(reflRay, pc.bvhCount, reflHit)) {
            reflT = reflHit.t; reflMatIdx = reflHit.materialIndex;
            reflNormal = reflHit.normal; reflIsBVH = true; reflUV = reflHit.uv;
        }

        // Passthrough removed: transparent objects render as glass surfaces in reflections.
        // Sky/ceiling behind glass looks identical (both grey) so passthrough was invisible;
        // showing the surface directly with minimum ambient makes glass/ice recognizable.

        vec3 reflColor = mix(pc.skyBottomColor.rgb, pc.skyTopColor.rgb,
                             clamp(0.5 * (reflDir.y + 1.0), 0.0, 1.0));
        if (reflMatIdx >= 0) {
            vec3 reflWorldPos = worldPos + reflDir * reflT;
            GPUMaterial reflMat = materials[reflMatIdx];

            vec3 reflAlbedo = reflIsBVH ? sampleAlbedo(reflMat, reflUV) : reflMat.color;
            reflAlbedo = applyProceduralPattern(reflMat, reflAlbedo, reflWorldPos);

            vec3 reflViewDir = -reflDir;

            // Probe lookup at reflected surface: illuminates the underside of objects
            // (shadow side, where direct light is zero) with proper GI from cascade.
            vec3 reflCascadeSpace = (reflWorldPos - pc.worldOriginSpacing.xyz) / pc.worldOriginSpacing.w - 0.5;
            ivec3 reflBase = ivec3(floor(reflCascadeSpace));
            vec3  reflF    = reflCascadeSpace - vec3(reflBase);
            vec3  reflIndirect  = vec3(0.0);
            float reflWtSum     = 0.0;
            for (int pz2 = 0; pz2 <= 1; pz2++) {
                for (int py2 = 0; py2 <= 1; py2++) {
                    for (int px2 = 0; px2 <= 1; px2++) {
                        ivec3 rp = reflBase + ivec3(px2, py2, pz2);
                        if (any(lessThan(rp, ivec3(0))) ||
                            any(greaterThanEqual(rp, pc.gridSizeOctRes.xyz))) continue;
                        uint rKey  = packCellKey(rp);
                        uint rSlot = probeLookup(rKey, uint(pc.hashSize));
                        if (rSlot == 0xFFFFFFFFu) continue;
                        float wx2 = (px2 == 0) ? (1.0 - reflF.x) : reflF.x;
                        float wy2 = (py2 == 0) ? (1.0 - reflF.y) : reflF.y;
                        float wz2 = (pz2 == 0) ? (1.0 - reflF.z) : reflF.z;
                        float w2  = wx2 * wy2 * wz2;
                        reflIndirect += sampleProbeIrradiance(rSlot, reflNormal) * w2;
                        reflWtSum    += w2;
                    }
                }
            }
            if (reflWtSum > 0.001) {
                reflIndirect /= reflWtSum;
            } else {
                for (int fz = -2; fz <= 2; fz++)
                for (int fy = -2; fy <= 2; fy++)
                for (int fx = -2; fx <= 2; fx++) {
                    ivec3 fp = reflBase + ivec3(fx, fy, fz);
                    if (any(lessThan(fp, ivec3(0))) || any(greaterThanEqual(fp, pc.gridSizeOctRes.xyz))) continue;
                    uint fSlot = probeLookup(packCellKey(fp), uint(pc.hashSize));
                    if (fSlot == 0xFFFFFFFFu) continue;
                    reflIndirect += sampleProbeIrradiance(fSlot, reflNormal);
                    reflWtSum    += 1.0;
                }
                if (reflWtSum > 0.001) reflIndirect /= reflWtSum;
                else reflIndirect = vec3(reflMat.ambient);
            }

            // Horizontal transparent surfaces (glass cube bottom face) must not get the
            // transparency ambient boost: it creates a flat grey(0.15) that looks opaque.
            // On these faces the r2 mirror also bounces straight down into the dark floor.
            bool isHorizTrans = reflMat.transparency > 0.5 && reflNormal.y < -0.9;
            bool isTrans = reflMat.transparency > 0.5;
            float reflAmbient = isHorizTrans
                ? reflMat.ambient
                : max(reflMat.ambient, reflMat.transparency * 0.2);
            reflColor = reflMat.emission + reflAlbedo * (reflAmbient + reflIndirect * pc.kIndirectScale);

            for (int l = 0; l < pc.lightCount; l++) {
                vec3  toLight  = lights[l].position - reflWorldPos;
                vec3  reflLDir = normalize(toLight);
                float reflDist = length(toLight);

                Ray reflShadow;
                reflShadow.origin    = reflWorldPos + reflNormal * 0.001;
                reflShadow.direction = reflLDir;
                reflShadow.tMin      = 0.001;
                reflShadow.tMax      = reflDist - 0.01;

                vec3 reflShadowAtten = analyticalShadow(reflShadow.origin, reflShadow.direction, reflShadow.tMax);
                if (dot(reflShadowAtten, reflShadowAtten) > 0.001) {
                    reflShadowAtten *= traverseBVHShadow(reflShadow, pc.bvhCount);
                    if (dot(reflShadowAtten, reflShadowAtten) > 0.001) {
                        float atten = 1.0 / max(reflDist * reflDist, 0.01);
                        vec3  attLt = lights[l].color * reflShadowAtten * atten;
                        if (reflMat.shadingModel == 1) {
                            reflColor += pbrShading(reflMat, reflAlbedo, reflNormal, reflViewDir, reflLDir, attLt);
                        } else {
                            reflColor += lambertianShading(reflMat, reflAlbedo, reflNormal, reflLDir, attLt);
                            reflColor += blingPhongShading(reflMat, attLt, reflNormal, reflLDir, reflViewDir, 50.0);
                        }
                    }
                }
            }

            // Second-order reflection: capture what the reflected surface itself reflects.
            // For horizontal transparent faces (isHorizTrans): the mirror r2 goes straight
            // down into the dark floor, giving grey. Instead use the transmission direction
            // (reflDir goes upward through the glass) as a proxy for what's seen above it.
            if (reflMat.reflection > 0.08) {
                vec3 r2Color;
                if (isHorizTrans) {
                    // Use sky at the upward (transmission) direction — approximates the
                    // ceiling/scene visible through the glass from the floor below.
                    r2Color = mix(pc.skyBottomColor.rgb, pc.skyTopColor.rgb,
                                  clamp(0.5 * (reflDir.y + 1.0), 0.0, 1.0));
                } else {
                    vec3  r2Dir    = reflect(reflDir, reflNormal);
                    float r2T      = 1e6;
                    int   r2MatIdx = -1;
                    vec3  r2Normal = vec3(0.0);
                    bool  r2IsBVH  = false;
                    vec2  r2UV     = vec2(0.0);

                    for (int i = 0; i < pc.planeCount; i++) {
                        float denom = dot(planes[i].normal, r2Dir);
                        if (abs(denom) < 1e-6) continue;
                        float t = dot(planes[i].center - reflWorldPos, planes[i].normal) / denom;
                        if (t > 0.001 && t < r2T) {
                            r2T = t; r2MatIdx = planes[i].materialIndex;
                            r2Normal = (denom < 0.0) ? planes[i].normal : -planes[i].normal;
                            r2IsBVH = false;
                        }
                    }
                    for (int i = 0; i < pc.quadCount; i++) {
                        float denom = dot(quads[i].normalVector, r2Dir);
                        if (abs(denom) < 1e-6) continue;
                        float t = dot(quads[i].corner - reflWorldPos, quads[i].normalVector) / denom;
                        if (t <= 0.001 || t >= r2T) continue;
                        vec3  p    = reflWorldPos + r2Dir * t - quads[i].corner;
                        float e1l2 = dot(quads[i].edge1, quads[i].edge1);
                        float e2l2 = dot(quads[i].edge2, quads[i].edge2);
                        float qu   = dot(p, quads[i].edge1) / e1l2;
                        float qv   = dot(p, quads[i].edge2) / e2l2;
                        if (qu < 0.0 || qu > 1.0 || qv < 0.0 || qv > 1.0) continue;
                        r2T = t; r2MatIdx = quads[i].materialIndex;
                        r2Normal = (denom < 0.0) ? quads[i].normalVector : -quads[i].normalVector;
                        r2IsBVH = false;
                    }
                    Ray r2Ray;
                    r2Ray.origin    = reflWorldPos + reflNormal * 0.002;
                    r2Ray.direction = r2Dir;
                    r2Ray.tMin      = 0.001;
                    r2Ray.tMax      = r2T;
                    HitInfo r2Hit;
                    if (traverseBVH(r2Ray, pc.bvhCount, r2Hit)) {
                        r2T = r2Hit.t; r2MatIdx = r2Hit.materialIndex;
                        r2Normal = r2Hit.normal; r2IsBVH = true; r2UV = r2Hit.uv;
                    }

                    r2Color = mix(pc.skyBottomColor.rgb, pc.skyTopColor.rgb,
                                  clamp(0.5 * (r2Dir.y + 1.0), 0.0, 1.0));
                    if (r2MatIdx >= 0) {
                        vec3        r2Pos    = reflWorldPos + r2Dir * r2T;
                        GPUMaterial r2Mat    = materials[r2MatIdx];
                        vec3        r2Albedo = r2IsBVH ? sampleAlbedo(r2Mat, r2UV) : r2Mat.color;
                        r2Albedo = applyProceduralPattern(r2Mat, r2Albedo, r2Pos);
                        float kR2Scale = 1.0 / max(float(pc.lightCount), 1.0);
                        r2Color = r2Mat.emission + r2Albedo * r2Mat.ambient;
                        for (int l = 0; l < pc.lightCount; l++) {
                            vec3  toL2   = lights[l].position - r2Pos;
                            float dist2  = length(toL2);
                            vec3  ldir2  = normalize(toL2);
                            float NdotL2 = max(0.0, dot(r2Normal, ldir2));
                            if (NdotL2 < 0.001) continue;
                            float atten2 = 1.0 / max(dist2 * dist2, 0.01);
                            r2Color += r2Albedo * r2Mat.diffuse * NdotL2 * lights[l].color * atten2 * kR2Scale;
                        }
                    }
                }
                reflColor = reflColor * (1.0 - reflMat.reflection) + r2Color * reflMat.reflection;
            }

            // Transparency passthrough with Snell's law refraction: for all glass surfaces,
            // compute entry refraction (air→glass) so each pixel angle sees a different
            // refracted direction, eliminating the flat-face appearance. Then trace through
            // to find the first opaque object. Exit refraction (glass→air) restores the
            // original angle for a parallel slab, matching the backup path-tracer behavior.
            if (isTrans) {
                // entryN points into incident medium (air side), away from glass interior.
                vec3 entryN = (dot(reflDir, reflNormal) < 0.0) ? reflNormal : -reflNormal;
                float tpEta = 1.0 / max(reflMat.ior, 1.0);
                vec3 tpDir = refract(reflDir, entryN, tpEta);
                if (dot(tpDir, tpDir) < 0.001) tpDir = reflDir;
                else tpDir = normalize(tpDir);

                vec3 tpPos = reflWorldPos - entryN * 0.005;
                vec3 transColor = mix(pc.skyBottomColor.rgb, pc.skyTopColor.rgb,
                                      clamp(0.5 * (tpDir.y + 1.0), 0.0, 1.0));
                bool tpFoundOpaque = false;
                for (int tp = 0; tp < 2; tp++) {
                    Ray tpRay;
                    tpRay.origin    = tpPos;
                    tpRay.direction = tpDir;
                    tpRay.tMin      = 0.001;
                    tpRay.tMax      = 8.0;
                    HitInfo tpHit;
                    if (!traverseBVH(tpRay, pc.bvhCount, tpHit)) break;
                    tpPos = tpPos + tpDir * tpHit.t;
                    GPUMaterial tpMat = materials[tpHit.materialIndex];
                    if (tpMat.transparency < 0.3) {
                        vec3 tpAlbedo = sampleAlbedo(tpMat, tpHit.uv);
                        tpAlbedo = applyProceduralPattern(tpMat, tpAlbedo, tpPos);
                        float tpScale = 1.0 / max(float(pc.lightCount), 1.0);
                        transColor = tpMat.emission + tpAlbedo * tpMat.ambient;
                        for (int l = 0; l < pc.lightCount; l++) {
                            vec3  toL   = lights[l].position - tpPos;
                            float dist  = length(toL);
                            vec3  ldir  = normalize(toL);
                            float NdotL = max(0.0, dot(tpHit.normal, ldir));
                            if (NdotL < 0.001) continue;
                            float atten = 1.0 / max(dist * dist, 0.01);
                            transColor += tpAlbedo * tpMat.diffuse * NdotL * lights[l].color * atten * tpScale;
                        }
                        tpFoundOpaque = true;
                        break;
                    } else {
                        // Exit refraction: glass → air. exitN points into glass (incident medium).
                        vec3 exitN = (dot(tpDir, tpHit.normal) > 0.0) ? -tpHit.normal : tpHit.normal;
                        vec3 exitDir = refract(tpDir, exitN, reflMat.ior);
                        if (dot(exitDir, exitDir) > 0.001) tpDir = normalize(exitDir);
                        tpPos = tpPos + tpDir * 0.01;
                    }
                }
                // Only blend when an opaque object was found through the glass.
                // Pure-sky passthrough (glass sphere, stained glass, etc.) would make
                // the floor reflection blindingly bright; the surface reflColor already
                // carries the correct dark/glassy look for those cases.
                if (tpFoundOpaque) {
                    reflColor = reflColor * (1.0 - reflMat.transparency) + transColor * reflMat.transparency;
                }
            }
        }

        color = color * (1.0 - mat.reflection) + reflColor * mat.reflection;
    }

    // Exponential distance fog. Density controlled via push constant (ImGUI slider).
    if (pc.fogBlendWithSky == 1) {
        float fogDepth  = length(worldPos - pc.camPos.xyz);
        float fogAtten  = exp(-pc.fogDensity * fogDepth);
        vec3  fogDir    = (fogDepth > 0.0001) ? normalize(worldPos - pc.camPos.xyz) : vec3(0.0, 0.0, 1.0);
        vec3  fogColor  = mix(pc.skyBottomColor.rgb, pc.skyTopColor.rgb,
                              clamp(0.5 * (fogDir.y + 1.0), 0.0, 1.0));
        color = mix(fogColor, color, fogAtten);
    }

    imageStore(outHDR, pixel, vec4(color, 1.0));
}