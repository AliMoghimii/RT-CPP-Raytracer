#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable
layout(local_size_x = 16, local_size_y = 16) in;

#include "../common/ray.glsl"
#include "../common/bvh.glsl"
#include "../common/material.glsl"
#include "../common/lighting.glsl"
#include "../common/shadow.glsl"
#include "../common/tlas.glsl"
#include "../common/octahedral.glsl"

// G-buffer inputs (set 1 = gbufDescSet)
layout(set = 1, binding = 0, rgba32f) uniform readonly image2D gPosition;
layout(set = 1, binding = 1, rgba16f) uniform readonly image2D gNormal;
layout(set = 1, binding = 2, rgba8)   uniform readonly image2D gAlbedo;
layout(set = 1, binding = 3, rgba16f) uniform readonly image2D gEmissive;
// Read-write: gather wrote all pixels; this pass overwrites only transparent pixels.
layout(set = 1, binding = 5, rgba16f) uniform image2D outHDR;

// Cascade-0 (set 2 = rcHashDescSets[0])
layout(std430, set = 2, binding = 0) readonly buffer HK  { uint hashKeys[];    };
layout(std430, set = 2, binding = 1) readonly buffer HV  { uint hashValues[];  };
layout(std430, set = 2, binding = 2) readonly buffer STK { uint slotToKey[];   };
layout(std430, set = 2, binding = 3) readonly buffer SC  { uint nextSlot;      };
layout(std430, set = 2, binding = 4) readonly buffer CD  { uvec2 cascadeData[]; };
layout(std430, set = 2, binding = 6) readonly buffer SH  { vec4 shCoeffs[];    };

struct GPUPlane {
    vec3 center; float p1;
    vec3 normal; int  materialIndex;
    float p2; float p3; float p4; float p5;
};
struct GPUQuad {
    vec3 corner;       float p1;
    vec3 edge1;        float p2;
    vec3 edge2;        float p3;
    vec3 normalVector; int   materialIndex;
    float p4; float p5; float p6; float p7;
};
layout(std430, set = 0, binding = 5) readonly buffer PlaneBuffer { GPUPlane planes[]; };
layout(std430, set = 0, binding = 6) readonly buffer QuadBuffer  { GPUQuad  quads[];  };

#include "../common/cascade_layout.glsl"

layout(push_constant) uniform TransparentPC {
    vec4  camPos;
    vec4  camForward;       // camRight/camUp reconstructed in main() from camForward + world up
    vec4  worldOriginSpacing;
    ivec4 gridSizeOctRes;
    vec4  skyBottomColor;   // horizon sky colour
    vec4  skyTopColor;      // zenith sky colour
    int bvhCount;
    int lightCount;
    int planeCount;
    int quadCount;
    int fogBlendWithSky;    // 1 = fog samples sky gradient; 0 = no fog applied
    int hashSize;
    float kIndirectScale;   // GI irradiance → color scale
    float fogDensity;       // exponential fog decay coefficient
} pc;

// ---- Helpers ----

vec3 analyticalShadow(vec3 origin, vec3 dir, float maxT) {
    vec3 atten = vec3(1.0);
    for (int i = 0; i < pc.planeCount; i++) {
        float denom = dot(planes[i].normal, dir);
        if (abs(denom) < 1e-6) continue;
        float t = dot(planes[i].center - origin, planes[i].normal) / denom;
        if (t <= 0.001 || t >= maxT) continue;
        GPUMaterial mat = materials[planes[i].materialIndex];
        if (mat.castShadows == 0) continue;
        if (mat.transparency > 0.01) { atten *= mat.color * mat.transparency; }
        else return vec3(0.0);
    }
    for (int i = 0; i < pc.quadCount; i++) {
        float denom = dot(quads[i].normalVector, dir);
        if (abs(denom) < 1e-6) continue;
        float t = dot(quads[i].corner - origin, quads[i].normalVector) / denom;
        if (t <= 0.001 || t >= maxT) continue;
        vec3  p    = origin + dir * t - quads[i].corner;
        float e1l2 = dot(quads[i].edge1, quads[i].edge1);
        float e2l2 = dot(quads[i].edge2, quads[i].edge2);
        float qu   = dot(p, quads[i].edge1) / e1l2;
        float qv   = dot(p, quads[i].edge2) / e2l2;
        if (qu < 0.0 || qu > 1.0 || qv < 0.0 || qv > 1.0) continue;
        GPUMaterial mat = materials[quads[i].materialIndex];
        if (mat.castShadows == 0) continue;
        if (mat.transparency > 0.01) { atten *= mat.color * mat.transparency; }
        else return vec3(0.0);
    }
    return atten;
}

// SH L0+L1 probe irradiance: 4 reads + dot-product (matches final_gather.comp).
vec3 sampleProbeIrradiance(uint slot, vec3 normal) {
    int base4 = int(slot) * 4;
    vec3 sh0 = shCoeffs[base4 + 0].rgb;
    vec3 sh1 = shCoeffs[base4 + 1].rgb;
    vec3 sh2 = shCoeffs[base4 + 2].rgb;
    vec3 sh3 = shCoeffs[base4 + 3].rgb;
    vec3 result = sh0 + sh1 * normal.x + sh2 * normal.y + sh3 * normal.z;
    return max(result, sh0 * 0.1);
}

// Hybrid analytical+BVH intersection. Returns the nearest hit along (origin, dir).
struct HitResult {
    float t;
    int matIdx;
    vec3 normal;
    vec2 uv;
    bool isPlane;
    bool hit;
};

HitResult findNearestHit(vec3 origin, vec3 dir) {
    HitResult res;
    res.t = 1e6;
    res.matIdx = -1;
    res.normal = vec3(0.0);
    res.uv = vec2(0.0);
    res.isPlane = false;
    res.hit = false;

    for (int i = 0; i < pc.planeCount; i++) {
        float denom = dot(planes[i].normal, dir);
        if (abs(denom) < 1e-6) continue;
        float t = dot(planes[i].center - origin, planes[i].normal) / denom;
        if (t > 0.001 && t < res.t) {
            res.t = t;
            res.matIdx = planes[i].materialIndex;
            res.normal = (denom < 0.0) ? planes[i].normal : -planes[i].normal;
            res.isPlane = true;
            res.hit = true;
        }
    }

    for (int i = 0; i < pc.quadCount; i++) {
        float denom = dot(quads[i].normalVector, dir);
        if (abs(denom) < 1e-6) continue;
        float t = dot(quads[i].corner - origin, quads[i].normalVector) / denom;
        if (t <= 0.001 || t >= res.t) continue;
        vec3 p = origin + dir * t - quads[i].corner;
        float e1l2 = dot(quads[i].edge1, quads[i].edge1);
        float e2l2 = dot(quads[i].edge2, quads[i].edge2);
        float qu = dot(p, quads[i].edge1) / e1l2;
        float qv = dot(p, quads[i].edge2) / e2l2;
        if (qu < 0.0 || qu > 1.0 || qv < 0.0 || qv > 1.0) continue;
        res.t = t;
        res.matIdx = quads[i].materialIndex;
        res.normal = (denom < 0.0) ? quads[i].normalVector : -quads[i].normalVector;
        res.uv = vec2(qu, qv);
        res.isPlane = false;
        res.hit = true;
    }

    Ray bvhRay;
    bvhRay.origin = origin;
    bvhRay.direction = dir;
    bvhRay.tMin = 0.001;
    bvhRay.tMax = res.t;
    HitInfo bvhHit;
    if (traverseScene(bvhRay, pc.bvhCount, bvhHit)) {
        res.t = bvhHit.t;
        res.matIdx = bvhHit.materialIndex;
        res.normal = bvhHit.normal;
        res.uv = bvhHit.uv;
        res.isPlane = false;
        res.hit = true;
    }

    return res;
}

// Full shading for the opaque surface at the end of the refraction chain.
// Direct lighting with analytical+BVH shadows, cascade-0 indirect GI, and
// one mirror bounce via findNearestHit() for reflective terminal surfaces.
vec3 shadeOpaque(GPUMaterial mat, vec3 worldPos, vec3 normal, vec3 albedo, vec3 viewDir) {
    vec3 color = mat.emission;

    for (int l = 0; l < pc.lightCount; l++) {
        vec3 toLight = lights[l].position - worldPos;
        vec3 lightDir = normalize(toLight);
        float lightDist = length(toLight);

        Ray shadowRay;
        shadowRay.origin = worldPos + normal * 0.001;
        shadowRay.direction = lightDir;
        shadowRay.tMin = 0.001;
        shadowRay.tMax = lightDist - 0.01;

        // Analytical shadow only — no BVH shadow inside refraction chains (too expensive).
        vec3 shadowAtten = analyticalShadow(shadowRay.origin, lightDir, shadowRay.tMax);
        if (dot(shadowAtten, shadowAtten) > 0.001) {
            float atten = 1.0 / max(lightDist * lightDist, 0.01);
            vec3  attLt = lights[l].color * shadowAtten * atten;
            if (mat.shadingModel == 1) {
                color += pbrShading(mat, albedo, normal, viewDir, lightDir, attLt);
            } else {
                color += lambertianShading(mat, albedo, normal, lightDir, attLt);
                color += blingPhongShading(mat, attLt, normal, lightDir, viewDir, 50.0);
            }
        }
    }

    // Cascade-0 indirect GI: trilinear probe interpolation at this surface position.
    // Falls back to mat.ambient when probes are unavailable (original constant-fill behavior).
    vec3 cascadeSpace = (worldPos - pc.worldOriginSpacing.xyz) / pc.worldOriginSpacing.w - 0.5;
    ivec3 base = ivec3(floor(cascadeSpace));
    vec3 f = cascadeSpace - vec3(base);
    vec3 indirect = vec3(0.0);
    float weightSum = 0.0;
    for (int pz = 0; pz <= 1; pz++) {
        for (int py = 0; py <= 1; py++) {
            for (int px = 0; px <= 1; px++) {
                ivec3 probe = base + ivec3(px, py, pz);
                if (any(lessThan(probe, ivec3(0))) ||
                    any(greaterThanEqual(probe, pc.gridSizeOctRes.xyz))) continue;
                uint pKey  = packCellKey(probe);
                uint pSlot = probeLookup(pKey, uint(pc.hashSize));
                if (pSlot == 0xFFFFFFFFu) continue;
                float wx = (px == 0) ? (1.0 - f.x) : f.x;
                float wy = (py == 0) ? (1.0 - f.y) : f.y;
                float wz = (pz == 0) ? (1.0 - f.z) : f.z;
                vec3 toProbe = (vec3(probe) + 0.5) * pc.worldOriginSpacing.w
                             + pc.worldOriginSpacing.xyz - worldPos;
                float wrapShading = (dot(normalize(toProbe), normal) + 1.0) * 0.5;
                float w = wx * wy * wz * (wrapShading * wrapShading + 0.2);
                indirect += sampleProbeIrradiance(pSlot, normal) * w;
                weightSum += w;
            }
        }
    }
    // Use max(gi, ambient) so that probes with near-zero irradiance in the queried direction
    // (e.g. back-face normals of spheres not in the G-buffer) don't create darker patches
    // than positions where no probe was found at all. mat.ambient is the minimum floor.
    if (weightSum > 0.001) {
        color += albedo * max((indirect / weightSum) * pc.kIndirectScale, vec3(mat.ambient * 0.05));
    } else {
        for (int fz = -1; fz <= 1; fz++)
        for (int fy = -1; fy <= 1; fy++)
        for (int fx = -1; fx <= 1; fx++) {
            ivec3 fp = base + ivec3(fx, fy, fz);
            if (any(lessThan(fp, ivec3(0))) || any(greaterThanEqual(fp, pc.gridSizeOctRes.xyz))) continue;
            uint fSlot = probeLookup(packCellKey(fp), uint(pc.hashSize));
            if (fSlot == 0xFFFFFFFFu) continue;
            indirect += sampleProbeIrradiance(fSlot, normal);
            weightSum += 1.0;
        }
        if (weightSum > 0.001) color += albedo * max((indirect / weightSum) * pc.kIndirectScale, vec3(mat.ambient * 0.05));
        else                    color += albedo * mat.ambient;
    }

    // --- First-order reflection for reflective terminal surfaces (T6) ---
    if (mat.reflection > 0.01) {
        vec3 reflDir = reflect(-viewDir, normal);
        vec3 reflOrigin = worldPos + normal * 0.002;
        HitResult reflHit = findNearestHit(reflOrigin, reflDir);

        vec3 reflColor;
        if (reflHit.hit) {
            GPUMaterial reflMat = materials[reflHit.matIdx];
            vec3 reflWorldPos = reflOrigin + reflDir * reflHit.t;
            vec3 reflAlbedo = reflHit.isPlane ? reflMat.color : sampleAlbedo(reflMat, reflHit.uv);
                 reflAlbedo = applyProceduralPattern(reflMat, reflAlbedo, reflWorldPos);
            vec3 reflViewDir = -reflDir;
            reflColor = reflMat.emission + reflAlbedo * reflMat.ambient;

            for (int l = 0; l < pc.lightCount; l++) {
                vec3  toLight = lights[l].position - reflWorldPos;
                vec3  lightDir = normalize(toLight);
                float lightDist = length(toLight);
                Ray shadowRay;
                shadowRay.origin = reflWorldPos + reflHit.normal * 0.001;
                shadowRay.direction = lightDir;
                shadowRay.tMin = 0.001;
                shadowRay.tMax = lightDist - 0.01;
                // Analytical shadow only for reflections inside glass.
                vec3 shadowAtten = analyticalShadow(shadowRay.origin, lightDir, shadowRay.tMax);
                if (dot(shadowAtten, shadowAtten) > 0.001) {
                    float atten = 1.0 / max(lightDist * lightDist, 0.01);
                    vec3  attLt = lights[l].color * shadowAtten * atten;
                    if (reflMat.shadingModel == 1) {
                        reflColor += pbrShading(reflMat, reflAlbedo, reflHit.normal, reflViewDir, lightDir, attLt);
                    } else {
                        reflColor += lambertianShading(reflMat, reflAlbedo, reflHit.normal, lightDir, attLt);
                        reflColor += blingPhongShading(reflMat, attLt, reflHit.normal, lightDir, reflViewDir, 50.0);
                    }
                }
            }
        } else {
            reflColor = mix(pc.skyBottomColor.rgb, pc.skyTopColor.rgb,
                            clamp(0.5 * (reflDir.y + 1.0), 0.0, 1.0));
        }

        color = color * (1.0 - mat.reflection) + reflColor * mat.reflection;
    }

    return color;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outHDR);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    // Sky pixels have gEmissive.a < 0; gather already wrote them correctly.
    vec4 emissiveData = imageLoad(gEmissive, pixel);
    if (emissiveData.a < 0.0) return;

    // Opaque pixels: gather already shaded them; leave outHDR untouched.
    int matIdx = int(round(emissiveData.a));
    GPUMaterial primaryMat = materials[matIdx];
    if (primaryMat.transparency <= 0.01) return;

    // --- Reconstruct primary ray ---
    // camRight and camUp are reconstructed from camForward + world up to save push constant space
    // (frees two vec4 slots for skyBottomColor/skyTopColor).
    // Guard: if camera looks nearly straight up/down, use a side fallback for the cross product.
    vec3 fwd = normalize(pc.camForward.xyz);
    vec3 worldUp = (abs(fwd.y) > 0.999) ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
    vec3 camRight = normalize(cross(worldUp, fwd));
    vec3 camUp    = normalize(cross(fwd, camRight));

    vec2 screenUV = (vec2(pixel) + 0.5) / vec2(size) * 2.0 - 1.0;
    screenUV.y = -screenUV.y;
    screenUV.x *= float(size.x) / float(size.y);
    screenUV *= tan(radians(30.0));  // half-FOV = 30 degrees
    vec3 primaryRayDir = normalize(camRight * screenUV.x + camUp * screenUV.y + fwd);

    // --- Refraction/reflection depth loop ---
    // First hit comes from G-buffer (saved primary.comp traversal cost).
    // Subsequent hits are traced with the hybrid analytical+BVH intersection.
    // Fog is applied per segment inside the loop (matches backup raytracer design), so
    // distant objects seen through glass receive the correct accumulated fog depth.

    vec3 accumulatedColor = vec3(0.0);
    vec3 attenuation = vec3(1.0);

    // Pre-baked albedo/roughness/metallic for the first transparent hit.
    // primary.comp already sampled all textures and stored the results in the G-buffer.
    // We reuse them here because hitUV is vec2(0) for the first hit (G-buffer doesn't store UVs).
    vec4 firstHitAlbedoData = imageLoad(gAlbedo, pixel);
    vec3 firstHitAlbedo = firstHitAlbedoData.rgb;
    float firstHitMetallic  = firstHitAlbedoData.a;
    float firstHitRoughness = imageLoad(gNormal, pixel).a;  // roughness stored in gNormal.w

    // rayOrig/rayDir track the next ray to cast (unused on the first iteration).
    vec3 rayOrig = pc.camPos.xyz;
    vec3 rayDir = primaryRayDir;
    bool firstHit = true;

    for (int depth = 0; depth < 4; depth++) {
        vec3 hitPos;
        vec3 hitNormal;
        GPUMaterial mat;
        vec2 hitUV;
        bool hitIsPlane;
        float segLength;   // world-space length of this ray segment (camera→first or prev→current)

        if (firstHit) {
            // Use G-buffer data; avoids re-tracing the primary ray through the glass.
            hitPos    = imageLoad(gPosition, pixel).xyz;
            hitNormal = normalize(imageLoad(gNormal, pixel).xyz);
            mat = primaryMat;
            mat.roughness = firstHitRoughness;
            mat.metallic  = firstHitMetallic;
            hitUV      = vec2(0.0);
            hitIsPlane = false;
            firstHit   = false;
            segLength  = length(hitPos - pc.camPos.xyz);
        } else {
            HitResult hr = findNearestHit(rayOrig, rayDir);

            if (!hr.hit) {
                // Ray escaped to sky. Attenuation already carries fog from prior segments;
                // sky is at practical infinity so we just add the residual sky colour.
                vec3 sky = mix(pc.skyBottomColor.rgb, pc.skyTopColor.rgb,
                               clamp(0.5 * (rayDir.y + 1.0), 0.0, 1.0));
                accumulatedColor += attenuation * sky;
                break;
            }

            segLength  = hr.t;
            hitPos     = rayOrig + rayDir * hr.t;
            hitNormal  = hr.normal;
            mat        = materials[hr.matIdx];
            hitUV      = hr.uv;
            hitIsPlane = hr.isPlane;
        }

        // Per-segment fog: applied BEFORE shading this surface, matching the backup raytracer.
        // This ensures objects seen through glass receive fog proportional to their true depth,
        // not just the depth to the glass surface.
        if (pc.fogBlendWithSky == 1) {
            float segFogAtten = exp(-pc.fogDensity * segLength);
            vec3  fogSegColor = mix(pc.skyBottomColor.rgb, pc.skyTopColor.rgb,
                                    clamp(0.5 * (rayDir.y + 1.0), 0.0, 1.0));
            accumulatedColor += attenuation * fogSegColor * (1.0 - segFogAtten);
            attenuation      *= segFogAtten;
        }

        // --- Opaque terminal surface: full shading + cascade GI ---
        if (mat.transparency <= 0.01) {
            vec2 surfUV = hitIsPlane ? (hitPos.xz * 0.1) : hitUV;
            vec3 albedo = sampleAlbedo(mat, surfUV);
                 albedo = applyProceduralPattern(mat, albedo, hitPos);
            vec3 viewDir = -rayDir;
            accumulatedColor += attenuation * shadeOpaque(mat, hitPos, hitNormal, albedo, viewDir);
            break;
        }

        // --- Transparent surface: Schlick Fresnel + Snell's law refraction ---
        // eta = n_incoming / n_outgoing (ratio of refractive indices).
        // If the ray opposes the normal (entering the medium, cosI < 0), eta = 1/ior (air->glass).
        // If the ray agrees with the normal (exiting), eta = ior (glass->air) and we flip n
        // so refract() always receives a normal that opposes the incoming ray.
        // Schlick Fresnel gives the reflection fraction; (1-fresnel) is the transmission fraction.
        // When refract() returns a zero vector, total internal reflection has occurred (critical
        // angle exceeded), so we force fresnel=1 to fall through to the reflection branch.
        float cosI = dot(rayDir, hitNormal);
        float eta = (cosI < 0.0) ? 1.0 / mat.ior : mat.ior;
        vec3 n = (cosI < 0.0) ? hitNormal : -hitNormal;
        cosI = abs(cosI);
        float r0 = (1.0 - eta) / (1.0 + eta); r0 *= r0;  // normal-incidence reflectance
        float fresnel = r0 + (1.0 - r0) * pow(1.0 - cosI, 5.0);
        vec3 refractDir = refract(rayDir, n, eta);
        if (length(refractDir) < 0.001) fresnel = 1.0;  // total internal reflection

        // Surface shading bleeds through at (1 - transparency): gives textured transparent
        // objects (ice, glass) their visible surface detail, shadows, and specular highlights.
        // Uses shadeOpaque for shadow testing + cascade GI — same as the opaque terminal path.
        // depth==0: use G-buffer albedo (primary.comp sampled textures + displacement).
        // depth>0: sample texture directly with BVH-provided hitUV.
        {
            vec3 surfAlbedo;
            if (depth == 0) {
                surfAlbedo = firstHitAlbedo;
            } else {
                vec2 sUV = hitIsPlane ? (hitPos.xz * 0.1) : hitUV;
                surfAlbedo = applyProceduralPattern(mat, sampleAlbedo(mat, sUV), hitPos, sUV);
            }
            accumulatedColor += attenuation
                              * shadeOpaque(mat, hitPos, hitNormal, surfAlbedo, -rayDir)
                              * (1.0 - mat.transparency);
        }

        if (fresnel < 1.0) {
            // Transmission: tint by mat.color (black for ice = kills refraction, giving the
            // dark crystalline look; clear glass keeps mat.color = white)
            attenuation *= mat.transparency * (1.0 - fresnel) * mat.color;
            rayOrig = hitPos - n * 0.001;
            rayDir = normalize(refractDir);
        } else {
            // Total internal reflection
            attenuation *= mat.reflection;
            rayOrig = hitPos + n * 0.001;
            rayDir = reflect(rayDir, n);
        }

        if (dot(attenuation, attenuation) < 0.0001) break;
    }

    // Fog is fully handled per-segment inside the loop above.
    imageStore(outHDR, pixel, vec4(accumulatedColor, 1.0));
}
