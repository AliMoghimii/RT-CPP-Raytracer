#version 460
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly  image2D inHDR;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outLDR;

layout(push_constant) uniform TonemapPC {
    float exposure;
    int tonemapMode; // 0=ACES Film  1=Reinhard  2=Linear
    int pad[2];
} pc;

// ACES Film tone mapping (Narkowicz 2015 approximation).
// Maps HDR luminance to [0,1] with a filmic S-curve: gentle roll-off in shadows,
// mid-tone contrast, and a soft shoulder that prevents burned-out highlights.
// The formula fits a rational polynomial to the original Academy Color Encoding System curve.
// Constants a-e were fitted to the ACES RRT+ODT for sRGB output.
vec3 ACESFilm(vec3 x) {
    const float a = 2.51, b = 0.03, c = 2.43, d = 0.59, e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

// Reinhard per-channel: x / (1+x) maps [0, inf) -> [0, 1).
// Simpler than ACES; brighter highlights roll off more softly, but can desaturate colors
// because bright channels are compressed more than dim ones in the same pixel.
vec3 Reinhard(vec3 x) { return x / (1.0 + x); }

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outLDR);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec3 hdr = imageLoad(inHDR, pixel).rgb * pc.exposure;
    vec3 ldr;
    if (pc.tonemapMode == 1) ldr = Reinhard(hdr);
    else if (pc.tonemapMode == 2) ldr = clamp(hdr, 0.0, 1.0);   // linear (matches original backup)
    else ldr = ACESFilm(hdr);           // default: ACES Film
    ldr = pow(ldr, vec3(1.0 / 2.2));    // linear -> sRGB gamma

    imageStore(outLDR, pixel, vec4(ldr, 1.0));
}